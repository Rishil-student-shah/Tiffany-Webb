<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editing <%= page.name %> — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <!-- Cropper.js Library -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <style>
        .tab-btn.active {
            background: rgba(217, 162, 58, 0.15) !important;
            color: var(--color-gold) !important;
            border-left: 3px solid var(--color-gold) !important;
        }
        .cms-image-field-card {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 1.5rem;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 1.25rem;
            margin-top: 0.5rem;
        }
        @media (max-width: 900px) {
            .cms-image-field-card {
                grid-template-columns: 1fr;
            }
        }
        .cms-frame-shape {
            width: 100%;
            height: 200px;
            background: #090907;
            border: 1.5px solid var(--color-gold);
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .cms-frame-shape.shape-hero-arch, .cms-frame-shape.shape-meet-arch {
            border-radius: 999px 999px 8px 8px;
            height: 220px;
        }
        .cms-preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .cropper-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(13, 12, 8, 0.92);
            backdrop-filter: blur(12px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .cropper-modal-container {
            background: #1C1A14;
            border: 1px solid rgba(217, 162, 58, 0.4);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 960px;
            overflow: hidden;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9);
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link active">Website Studio</a>
            <a href="/users" class="nav-link">Team & Access</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content" style="max-width: 1300px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
            <div>
                <a href="/cms" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.82rem; margin-bottom: 1rem; display: inline-flex;">
                    &larr; Back to Website Studio
                </a>
                <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                    Page Content Customizer
                </div>
                <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;">Editing: <span class="italic-accent"><%= page.name %></span></h1>
            </div>
            <button type="submit" form="contentForm" class="btn btn-primary" style="padding: 0.85rem 2.2rem; font-size: 0.95rem;">
                Save Page Changes
            </button>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <form id="contentForm" action="/cms/<%= page.slug %>" method="POST" enctype="multipart/form-data">
            <% 
            const uniqueSections = new Set([...Object.keys(sections), ...(typeof definedCollections !== 'undefined' ? definedCollections : [])]);
            let allSections = Array.from(uniqueSections);
            
            const pageOrder = [
                'hero', 'impact_band', 'credibility_bar', 'meet_tiffany', 'story', 'story_vignettes', 'journey', 'timeline_items', 
                'mission', 'vision', 'vision_items', 'values', 'values_list', 'milestones', 'gamblefreegear',
                'why_tiffany', 'why_cards', 'flagship', 'tracks', 'tracks_list', 'formats', 'engagement_formats', 'working_process',
                'capabilities', 'gear_method', 'gear_steps', 'partnership_framework', 'process', 'working_steps',
                'articles_section', 'articles', 'bios_section', 'bios', 'intro_script', 'downloads_section', 'downloads',
                'booking_form', 'booking_steps', 'journey', 'faqs', 'direct_contact',
                'who_can_benefit', 'expertise', 'speaking', 'events', 'proof', 'proof_attributes', 'video_reels', 'proof_testimonials', 
                'testimonials', 'booking', 'cta', 'media', 'social_links', 'footer'
            ];
            
            allSections.sort((a, b) => {
                const indexA = pageOrder.indexOf(a);
                const indexB = pageOrder.indexOf(b);
                if (indexA === -1 && indexB === -1) return a.localeCompare(b);
                if (indexA === -1) return 1;
                if (indexB === -1) return -1;
                return indexA - indexB;
            });
            %>
            <% if (allSections.length === 0) { %>
                <div class="panel" style="text-align: center; color: var(--color-text-dim); padding: 3rem;">
                    <p style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-ivory);">No editable content found for this page.</p>
                </div>
            <% } else { %>
                <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2rem; align-items: start;">
                    
                    <!-- Section Navigation Sidebar -->
                    <div class="panel" style="padding: 1.25rem; position: sticky; top: 5.5rem;">
                        <span class="data-label" style="display: block; margin-bottom: 0.85rem; padding-left: 0.5rem;">Page Sections</span>
                        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.35rem;" id="tabNav">
                            <% allSections.forEach((sectionName, index) => { %>
                                <li>
                                    <button type="button" class="tab-btn <%= index === 0 ? 'active' : '' %>" data-target="section-<%= sectionName %>" style="width: 100%; text-align: left; padding: 0.75rem 1rem; color: var(--color-ivory); text-transform: capitalize; border-radius: var(--radius-md); font-size: 0.88rem; font-weight: 600; font-family: var(--font-sans); background: transparent; border: none; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: space-between;">
                                        <%= sectionName.replace(/_/g, ' ') %>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </button>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <!-- Content Forms -->
                    <div class="panel" style="padding: 2.25rem; min-height: 500px;">
                        <% allSections.forEach((sectionName, index) => { %>
                            <div id="section-<%= sectionName %>" class="tab-pane" style="display: <%= index === 0 ? 'block' : 'none' %>;">
                                <div style="border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 1.25rem; margin-bottom: 2rem;">
                                    <h2 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-ivory); margin: 0; text-transform: capitalize;">
                                        <%= sectionName.replace(/_/g, ' ') %> <span class="italic-accent">Section</span>
                                    </h2>
                                </div>
                                
                                <div style="display: flex; flex-direction: column; gap: 2rem;">
                                    <!-- Static KV Content -->
                                    <% if (sections[sectionName]) { %>
                                        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                                            <% sections[sectionName].forEach(item => { %>
                                                <% if (item.key_name.includes('frame_style')) return; %>
                                                <div class="form-group">
                                                    <% if (item.key_name !== 'section_is_active') { %>
                                                        <label><%= item.key_name.replace(/_/g, ' ') %></label>
                                                    <% } %>
                                                    
                                                    <% if (item.key_name === 'section_is_active') { %>
                                                        <div style="display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1.25rem; background: rgba(217, 162, 58, 0.08); border-radius: var(--radius-md); border: 1px solid var(--color-border);">
                                                            <input type="checkbox" value="1" <%= item.content_value === '1' ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--color-gold); cursor: pointer;" onchange="document.getElementById('hidden_<%= item.id %>').value = this.checked ? '1' : '0';">
                                                            <span style="font-size: 0.88rem; color: var(--color-gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Display this section on the live website</span>
                                                            <input type="hidden" id="hidden_<%= item.id %>" name="content_<%= item.id %>" value="<%= item.content_value %>">
                                                        </div>
                                                    <% } else if (item.content_type === 'text') { %>
                                                        <% if (item.content_value && item.content_value.length > 80) { %>
                                                            <textarea name="content_<%= item.id %>" rows="3"><%= item.content_value %></textarea>
                                                        <% } else { %>
                                                            <input type="text" name="content_<%= item.id %>" value="<%= item.content_value || '' %>">
                                                        <% } %>
                                                    <% } else if (item.content_type === 'html') { %>
                                                        <textarea name="content_<%= item.id %>" rows="4" style="font-family: var(--font-mono); font-size: 0.85rem;"><%= item.content_value %></textarea>
                                                        <small style="color: var(--color-text-dim); font-size: 0.75rem;">Supports HTML elements (&lt;br&gt;, &lt;strong&gt;, etc.).</small>
                                                    <% } else if (item.content_type === 'image') { %>
                                                        <div class="cms-image-field-card">
                                                            <div>
                                                                <span class="data-label">Image Path / URL</span>
                                                                <input type="text" id="input_path_<%= item.id %>" name="content_<%= item.id %>" value="<%= item.content_value || '' %>" placeholder="/uploads/example.png" style="margin-top: 0.4rem; margin-bottom: 0.75rem;" oninput="updateFieldPreview('<%= item.id %>', this.value)">
                                                                
                                                                <input type="file" id="file_input_<%= item.id %>" name="image_upload_<%= item.id %>" accept="image/*" style="display: none;" onchange="handleFileSelected(event, '<%= item.id %>')">
                                                                <button type="button" class="btn btn-outline" style="font-size: 0.82rem;" onclick="document.getElementById('file_input_<%= item.id %>').click()">
                                                                    Choose & Upload Image
                                                                </button>
                                                            </div>

                                                            <div>
                                                                <span class="data-label" style="display: block; margin-bottom: 0.4rem;">Preview</span>
                                                                <div id="preview_frame_<%= item.id %>" class="cms-frame-shape">
                                                                    <% if (item.content_value && item.content_value.trim().length > 0) { %>
                                                                        <img id="img_preview_<%= item.id %>" src="<%= item.content_value %>" class="cms-preview-img" style="display: block;">
                                                                        <span style="font-size: 0.75rem; color: var(--color-text-muted); display: none;">No image uploaded (Optional)</span>
                                                                    <% } else { %>
                                                                        <img id="img_preview_<%= item.id %>" src="" class="cms-preview-img" style="display: none;">
                                                                        <span style="font-size: 0.75rem; color: var(--color-text-muted); display: block;">No image uploaded (Optional)</span>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                    
                                    <!-- Collection Items -->
                                    <% if (typeof definedCollections !== 'undefined' && definedCollections.includes(sectionName)) { %>
                                        <div style="border-top: 1px solid var(--color-border-subtle); padding-top: 2rem;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                                                <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.35rem; color: var(--color-ivory);">Collection Items</h3>
                                                <a href="/cms/<%= page.slug %>/collection/<%= sectionName %>/new" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.4rem 1rem;">
                                                    + Add New Item
                                                </a>
                                            </div>
                                            
                                            <table style="width: 100%;">
                                                <thead>
                                                    <tr>
                                                        <th>Title</th>
                                                        <th>Sort Order</th>
                                                        <th style="text-align: right;">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (collectionSections[sectionName] && collectionSections[sectionName].length > 0) { %>
                                                        <% collectionSections[sectionName].forEach(colItem => { %>
                                                            <tr>
                                                                <td style="font-weight: 600; color: var(--color-ivory);"><%= colItem.title || '(Untitled Item)' %></td>
                                                                <td style="font-family: var(--font-mono); color: var(--color-text-muted);"><%= colItem.sort_order %></td>
                                                                <td style="text-align: right;">
                                                                    <a href="/cms/<%= page.slug %>/collection/<%= sectionName %>/<%= colItem.id %>/edit" class="btn btn-outline" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; margin-right: 0.5rem;">Edit</a>
                                                                    <a href="/cms/collection/<%= colItem.id %>/delete?redirect=/cms/<%= page.slug %>" class="btn btn-ghost-danger" style="padding: 0.25rem 0.5rem;" onclick="return confirm('Delete this collection item?');">Del</a>
                                                                </td>
                                                            </tr>
                                                        <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="3" style="text-align: center; color: var(--color-text-dim); padding: 2rem;">No items in this collection yet.</td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </form>
    </div>

    <script>
        function updateFieldPreview(id, src) {
            const img = document.getElementById('img_preview_' + id);
            if (!img) return;
            if (src && src.trim() !== '') {
                img.src = src;
                img.style.display = 'block';
                if (img.nextElementSibling) img.nextElementSibling.style.display = 'none';
            } else {
                img.style.display = 'none';
                if (img.nextElementSibling) img.nextElementSibling.style.display = 'block';
            }
        }

        function handleFileSelected(e, id) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                updateFieldPreview(id, evt.target.result);
                const pathInput = document.getElementById('input_path_' + id);
                if (pathInput) pathInput.value = '(Selected file ready for upload)';
            };
            reader.readAsDataURL(file);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabPanes = document.querySelectorAll('.tab-pane');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    tabBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    tabPanes.forEach(p => p.style.display = 'none');
                    const targetId = btn.getAttribute('data-target');
                    const targetPane = document.getElementById(targetId);
                    if (targetPane) targetPane.style.display = 'block';
                });
            });
        });
    </script>
    <script src="/js/impact-os-cursor.js"></script>
</body>
</html>
