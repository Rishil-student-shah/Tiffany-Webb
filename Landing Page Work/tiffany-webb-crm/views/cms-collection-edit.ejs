<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= item ? 'Edit Collection Item' : 'New Collection Item' %> — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <!-- Cropper.js Library -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <style>
        .studio-card {
            background: var(--color-card);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 2.25rem;
        }
        .media-source-box {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 1.25rem;
            margin-top: 0.5rem;
        }
        .video-tab-btn {
            background: transparent;
            border: 1px solid var(--color-border);
            color: var(--color-text-muted);
            padding: 0.55rem 1.1rem;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .video-tab-btn.active {
            background: rgba(217, 162, 58, 0.15);
            border-color: var(--color-gold);
            color: var(--color-gold);
        }
        /* Interactive Cropper Modal */
        .cropper-modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(13, 12, 8, 0.92);
            backdrop-filter: blur(12px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .cropper-modal-window {
            background: #1C1A14;
            border: 1px solid rgba(217, 162, 58, 0.4);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 960px;
            overflow: hidden;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9), 0 0 50px rgba(217, 162, 58, 0.15);
        }
        .aspect-btn {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            color: var(--color-text-muted);
            padding: 0.45rem 0.85rem;
            border-radius: var(--radius-sm);
            font-size: 0.75rem;
            font-family: var(--font-mono);
            cursor: pointer;
            transition: all 0.2s;
        }
        .aspect-btn.active, .aspect-btn:hover {
            background: var(--color-gold);
            color: #0D0C08;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link active">Website Studio</a>
            <a href="/users" class="nav-link">Team & Access</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content" style="max-width: 880px;">
        <div style="margin-bottom: 2rem;">
            <a href="/cms/<%= page.slug %>" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.82rem; margin-bottom: 1rem; display: inline-flex;">
                &larr; Back to <%= page.name %> Page Editor
            </a>
            <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                Multi-Asset Studio Editor
            </div>
            <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;"><%= item ? 'Edit' : 'Add New' %> <span class="italic-accent">Collection Item</span></h1>
            <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
                Page: <strong><%= page.name %></strong> &bull; Section: <strong style="text-transform: capitalize;"><%= section.replace(/_/g, ' ') %></strong>
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <div class="studio-card">
            <form action="/cms/<%= page.slug %>/collection/<%= section %><%= item ? '/' + item.id + '/edit' : '/new' %>" method="POST" enctype="multipart/form-data">
                
                <div class="form-group">
                    <label>Item Title / Headline</label>
                    <input type="text" name="title" value="<%= item ? (item.title || '') : '' %>" placeholder="e.g. Healthcare Resilience Keynote">
                </div>

                <div class="form-group">
                    <label>Subtitle / Role / Supporting Label</label>
                    <input type="text" name="subtitle" value="<%= item ? (item.subtitle || '') : '' %>" placeholder="e.g. For Executive Leadership and Boardrooms">
                </div>

                <% if (section === 'video_reels') { %>
                    <div class="form-group">
                        <label>Duration Badge (e.g. 1:15 or KEYNOTE CLIP)</label>
                        <input type="text" name="badge" value="<%= item ? (item.badge || '') : '' %>" placeholder="e.g. 1:30 or EXECUTIVE CLIP">
                    </div>

                    <!-- Video Studio Source -->
                    <div class="form-group">
                        <label>Video Media Source</label>
                        <div class="media-source-box">
                            <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 0.75rem;">
                                <button type="button" id="tab-btn-file" class="video-tab-btn <%= (item && item.link_url && item.link_url.startsWith('/uploads/')) ? 'active' : '' %>" onclick="switchVideoTab('file')">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                    Direct Video Upload (.mp4, .webm, .mov)
                                </button>
                                <button type="button" id="tab-btn-url" class="video-tab-btn <%= (item && item.link_url && item.link_url.startsWith('/uploads/')) ? '' : 'active' %>" onclick="switchVideoTab('url')">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                    External Video Stream URL
                                </button>
                            </div>

                            <!-- Direct File Upload -->
                            <div id="video-tab-file" style="<%= (item && item.link_url && item.link_url.startsWith('/uploads/')) ? 'display: block;' : 'display: none;' %>">
                                <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
                                    Upload direct MP4 / WebM video reel (Max 60MB):
                                </p>
                                <% if (item && item.link_url && item.link_url.startsWith('/uploads/')) { %>
                                    <input type="hidden" name="existing_video_url" value="<%= item.link_url %>">
                                    <div style="margin-bottom: 0.75rem; padding: 0.6rem 0.85rem; background: rgba(217, 162, 58, 0.1); border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.82rem; color: var(--color-gold);">
                                        Current Video Asset: <strong><%= item.link_url %></strong>
                                    </div>
                                <% } %>
                                <input type="file" name="video_file" accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov">
                            </div>

                            <!-- External Stream URL -->
                            <div id="video-tab-url" style="<%= (item && item.link_url && item.link_url.startsWith('/uploads/')) ? 'display: none;' : 'display: block;' %>">
                                <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
                                    Enter YouTube, Vimeo, or CDN stream URL:
                                </p>
                                <input type="url" name="link_url" value="<%= (item && item.link_url && !item.link_url.startsWith('/uploads/')) ? item.link_url : '' %>" placeholder="https://youtube.com/watch?v=... or https://vimeo.com/...">
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="form-group">
                        <label>Badge / Category Tag</label>
                        <input type="text" name="badge" value="<%= item ? (item.badge || '') : '' %>" placeholder="e.g. KEYNOTE, ADVISORY, WORKSHOP">
                    </div>

                    <div class="form-group">
                        <label>Item Content / Rich Description</label>
                        <textarea name="content_html" rows="5" placeholder="Detailed editorial copy..."><%= item ? (item.content_html || '') : '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label>Action Link URL</label>
                        <input type="text" name="link_url" value="<%= item ? (item.link_url || '') : '' %>" placeholder="e.g. /contact or /services">
                    </div>
                <% } %>

                <!-- IMAGE & POSTER THUMBNAIL STUDIO -->
                <div class="form-group">
                    <label>Cover / Poster Image</label>
                    <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem;">
                        <div>
                            <span class="data-label">Image Path / URL</span>
                            <input type="text" id="imagePathInput" name="image_url" value="<%= item ? (item.image_url || '') : '' %>" placeholder="/uploads/example.png" style="margin-top: 0.4rem; margin-bottom: 1rem;" oninput="updateImagePreview(this.value)">

                            <div style="display: flex; gap: 0.75rem; align-items: center;">
                                <input type="file" id="imageFileInput" name="image_file" accept="image/*" style="display: none;" onchange="initImageCropper(event)">
                                <button type="button" class="btn btn-outline" style="font-size: 0.82rem;" onclick="document.getElementById('imageFileInput').click()">
                                    Upload & Crop Image
                                </button>
                                <% if (item && item.image_url) { %>
                                    <button type="button" class="btn btn-outline" style="font-size: 0.82rem; border-color: var(--color-gold); color: var(--color-gold);" onclick="reCropExisting('<%= item.image_url %>')">
                                        Re-Crop
                                    </button>
                                <% } %>
                            </div>
                        </div>

                        <!-- LIVE CARD MOCKUP -->
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: #090907; border: 1px solid var(--color-border-subtle); border-radius: 10px; padding: 1rem; min-height: 160px;">
                            <span class="data-label" style="margin-bottom: 0.5rem;">Live Card Mockup</span>
                            <div id="mockupFrame" style="width: 180px; height: 110px; border-radius: 8px; border: 1.5px solid var(--color-gold); overflow: hidden; display: flex; align-items: center; justify-content: center; background: #1C1A14;">
                                <img id="previewImg" src="<%= item ? (item.image_url || '') : '' %>" style="width: 100%; height: 100%; object-fit: cover; display: <%= item && item.image_url ? 'block' : 'none' %>;">
                                <span id="noImgLabel" style="font-size: 0.75rem; color: var(--color-text-dim); display: <%= item && item.image_url ? 'none' : 'block' %>;">No Image Set</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Sort Order Weight (Ascending)</label>
                    <input type="number" name="sort_order" value="<%= item ? (item.sort_order || 0) : 0 %>" style="max-width: 160px;">
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: flex-end;">
                    <a href="/cms/<%= page.slug %>" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary"><%= item ? 'Save Item Changes' : 'Publish New Item' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- CROPPER MODAL -->
    <div id="cropperModal" class="cropper-modal-backdrop">
        <div class="cropper-modal-window">
            <div style="padding: 1.25rem 1.75rem; border-bottom: 1px solid var(--color-border-subtle); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--color-ivory); margin: 0;">Interactive Image Cropper</h3>
                    <span style="font-size: 0.75rem; color: var(--color-gold);">Adjust framing, zoom, and aspect ratio</span>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button type="button" class="aspect-btn active" onclick="setCropperAspect(16/9, this)">16:9</button>
                    <button type="button" class="aspect-btn" onclick="setCropperAspect(4/5, this)">4:5</button>
                    <button type="button" class="aspect-btn" onclick="setCropperAspect(1, this)">1:1</button>
                    <button type="button" class="aspect-btn" onclick="setCropperAspect(NaN, this)">Free</button>
                </div>
            </div>

            <div style="height: 380px; background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                <img id="cropperTargetImg" style="max-width: 100%; max-height: 100%;">
            </div>

            <div style="padding: 1.25rem 1.75rem; background: #14130E; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: flex-end; gap: 1rem;">
                <button type="button" class="btn btn-outline" onclick="closeCropperModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="applyCroppedImage()">Apply Crop</button>
            </div>
        </div>
    </div>

    <script>
        function switchVideoTab(tab) {
            const btnFile = document.getElementById('tab-btn-file');
            const btnUrl = document.getElementById('tab-btn-url');
            const paneFile = document.getElementById('video-tab-file');
            const paneUrl = document.getElementById('video-tab-url');

            if (tab === 'file') {
                btnFile.classList.add('active');
                btnUrl.classList.remove('active');
                paneFile.style.display = 'block';
                paneUrl.style.display = 'none';
            } else {
                btnUrl.classList.add('active');
                btnFile.classList.remove('active');
                paneUrl.style.display = 'block';
                paneFile.style.display = 'none';
            }
        }

        let cropperInstance = null;

        function updateImagePreview(src) {
            const img = document.getElementById('previewImg');
            const noImg = document.getElementById('noImgLabel');
            if (src && src.trim() !== '') {
                img.src = src;
                img.style.display = 'block';
                noImg.style.display = 'none';
            } else {
                img.style.display = 'none';
                noImg.style.display = 'block';
            }
        }

        function initImageCropper(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                openCropperWithImage(e.target.result);
            };
            reader.readAsDataURL(file);
        }

        function reCropExisting(url) {
            openCropperWithImage(url);
        }

        function openCropperWithImage(imageSrc) {
            const modal = document.getElementById('cropperModal');
            const targetImg = document.getElementById('cropperTargetImg');
            targetImg.src = imageSrc;
            modal.style.display = 'flex';

            if (cropperInstance) {
                cropperInstance.destroy();
            }

            cropperInstance = new Cropper(targetImg, {
                aspectRatio: 16 / 9,
                viewMode: 1,
                autoCropArea: 0.95
            });
        }

        function setCropperAspect(ratio, btn) {
            document.querySelectorAll('.aspect-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            if (cropperInstance) {
                cropperInstance.setAspectRatio(ratio);
            }
        }

        function closeCropperModal() {
            const modal = document.getElementById('cropperModal');
            modal.style.display = 'none';
            if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
            }
        }

        function applyCroppedImage() {
            if (!cropperInstance) return;
            const canvas = cropperInstance.getCroppedCanvas({
                maxWidth: 1600,
                maxHeight: 1600,
                imageSmoothingQuality: 'high'
            });

            const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
            updateImagePreview(dataUrl);
            const pathInput = document.getElementById('imagePathInput');
            if (pathInput) pathInput.value = dataUrl;
            const fileInput = document.getElementById('imageFileInput');
            if (fileInput) fileInput.value = ''; // Reset raw file so server uses cropped dataUrl
            closeCropperModal();
        }
    </script>
</body>
</html>
