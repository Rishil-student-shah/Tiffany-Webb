<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lead.contact_name || 'Lead Details' %> — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <style>
        .lead-detail-grid {
            display: grid;
            grid-template-columns: 1.8fr 1.2fr;
            gap: 2rem;
        }
        @media (max-width: 1024px) {
            .lead-detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link active">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link">Website Studio</a>
            <a href="/users" class="nav-link">Team & Access</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content">
        <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <a href="/dashboard" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.82rem; margin-bottom: 1rem; display: inline-flex;">
                    &larr; Back to Pipeline Ledger
                </a>
                <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                    Lead Management Profile
                </div>
                <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;"><%= lead.contact_name || lead.phone || 'Inquiry' %> <span class="italic-accent">Profile</span></h1>
            </div>
            
            <!-- STATUS SWITCHER -->
            <div style="background: var(--color-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 0.75rem 1.25rem; display: flex; align-items: center; gap: 1rem;">
                <span style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-gold); font-weight: 700;">Stage</span>
                <form action="/lead/<%= lead.id %>/status" method="POST" style="margin: 0;">
                    <select name="status" onchange="this.form.submit()" style="padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; text-transform: uppercase;">
                        <% const statuses = ['new', 'contacted', 'qualified', 'proposal_sent', 'booked', 'completed', 'declined', 'lost']; %>
                        <% statuses.forEach(s => { %>
                            <option value="<%= s %>" <%= lead.status === s ? 'selected' : '' %>><%= s.replace('_', ' ').toUpperCase() %></option>
                        <% }); %>
                    </select>
                </form>
            </div>
        </div>

        <!-- ATTRIBUTION & ORIGIN BANNER -->
        <div class="attribution-banner">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 0.65rem;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <h3 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--color-ivory); margin: 0;">Lead Origin & Inbound Attribution</h3>
                </div>
                <span class="nav-pill" style="border-color: rgba(217, 162, 58, 0.4);"><%= lead.source.toUpperCase() %></span>
            </div>
            <div class="attribution-grid">
                <div>
                    <span class="data-label">Origin Section</span>
                    <span class="data-value" style="font-size: 1rem;"><%= lead.source_section || 'General Direct Inquiry' %></span>
                </div>
                <div>
                    <span class="data-label">Trigger Card / Source</span>
                    <span class="data-value" style="font-size: 1rem; color: var(--color-gold);"><%= lead.source_card || 'Website Contact Form' %></span>
                </div>
                <div>
                    <span class="data-label">Primary Topic Interest</span>
                    <span class="data-value" style="font-size: 1rem;"><%= lead.topic_interest || 'General Keynote / Advisory' %></span>
                </div>
                <div>
                    <span class="data-label">Estimated Budget</span>
                    <span class="data-value" style="font-size: 1rem; color: #10b981;"><%= lead.budget_range || 'Not Specified' %></span>
                </div>
            </div>
        </div>

        <div class="lead-detail-grid">
            <!-- LEFT COLUMN: LEAD OVERVIEW / EDIT -->
            <div>
                <div class="panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 1rem;">
                        <h2 class="panel-title" style="margin: 0;">Inquiry Details</h2>
                        <div style="display: flex; gap: 0.75rem;">
                            <button class="btn btn-outline" onclick="toggleEdit()" id="editToggleBtn">Edit Details</button>
                            <form action="/lead/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('Are you certain you want to delete this lead? This action is permanent.');" style="margin: 0;">
                                <button type="submit" class="btn btn-danger">Delete Lead</button>
                            </form>
                        </div>
                    </div>

                    <!-- VIEW MODE -->
                    <div id="view-mode" class="data-grid">
                        <div class="data-item">
                            <span class="data-label">Contact Name</span>
                            <span class="data-value"><%= lead.contact_name || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Organization / Company</span>
                            <span class="data-value"><%= lead.organization_name || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Email Address</span>
                            <span class="data-value"><%= lead.email || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Phone Number</span>
                            <span class="data-value"><%= lead.country_code ? lead.country_code + ' ' : '' %><%= lead.phone || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Event Type</span>
                            <span class="data-value"><%= lead.event_type || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Target Event Date</span>
                            <span class="data-value"><%= lead.event_date ? new Date(lead.event_date).toLocaleDateString(undefined, {year: 'numeric', month: 'long', day: 'numeric'}) : 'TBD' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Event Location</span>
                            <span class="data-value"><%= lead.event_location || '—' %></span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Audience Size</span>
                            <span class="data-value"><%= lead.estimated_audience_size || '—' %></span>
                        </div>
                    </div>

                    <!-- EDIT FORM -->
                    <form id="edit-mode" action="/lead/<%= lead.id %>/edit" method="POST" style="display: none;">
                        <div class="data-grid" style="margin-bottom: 1rem;">
                            <div class="form-group">
                                <label>Contact Name</label>
                                <input type="text" name="contact_name" value="<%= lead.contact_name || '' %>">
                            </div>
                            <div class="form-group">
                                <label>Organization</label>
                                <input type="text" name="organization_name" value="<%= lead.organization_name || '' %>">
                            </div>
                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" name="email" value="<%= lead.email || '' %>">
                            </div>
                            <div class="form-group">
                                <label>Country Code & Phone</label>
                                <div style="display: flex; gap: 0.5rem;">
                                    <select name="country_code" style="width: 130px;">
                                        <option value="+1" <%= lead.country_code === '+1' ? 'selected' : '' %>>+1 (US/CA)</option>
                                        <option value="+44" <%= lead.country_code === '+44' ? 'selected' : '' %>>+44 (UK)</option>
                                        <option value="+61" <%= lead.country_code === '+61' ? 'selected' : '' %>>+61 (AU)</option>
                                        <option value="+91" <%= lead.country_code === '+91' ? 'selected' : '' %>>+91 (IN)</option>
                                        <option value="+86" <%= lead.country_code === '+86' ? 'selected' : '' %>>+86 (CN)</option>
                                        <option value="+81" <%= lead.country_code === '+81' ? 'selected' : '' %>>+81 (JP)</option>
                                        <option value="+49" <%= lead.country_code === '+49' ? 'selected' : '' %>>+49 (DE)</option>
                                        <option value="+33" <%= lead.country_code === '+33' ? 'selected' : '' %>>+33 (FR)</option>
                                        <option value="+971" <%= lead.country_code === '+971' ? 'selected' : '' %>>+971 (AE)</option>
                                    </select>
                                    <input type="tel" name="phone" value="<%= lead.phone || '' %>" placeholder="Phone number">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Event Type</label>
                                <select name="event_type">
                                    <% const types = ['Conference Keynote', 'Executive Boardroom', 'Healthcare Organization', 'University & Higher Ed', 'Workshop / Training', 'Public Health / Non-Profit']; %>
                                    <% types.forEach(t => { %>
                                        <option value="<%= t %>" <%= lead.event_type === t ? 'selected' : '' %>><%= t %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Topic Interest</label>
                                <input type="text" name="topic_interest" value="<%= lead.topic_interest || '' %>">
                            </div>
                            <div class="form-group">
                                <label>Target Event Date</label>
                                <input type="date" name="event_date" value="<%= lead.event_date ? new Date(lead.event_date).toISOString().split('T')[0] : '' %>">
                            </div>
                            <div class="form-group">
                                <label>Location</label>
                                <input type="text" name="event_location" value="<%= lead.event_location || '' %>">
                            </div>
                            <div class="form-group">
                                <label>Audience Size</label>
                                <select name="estimated_audience_size">
                                    <% const sizes = ['Under 50 attendees', '50–150 attendees', '150–500 attendees', '500+ attendees', '1,000+ Keynote']; %>
                                    <% sizes.forEach(s => { %>
                                        <option value="<%= s %>" <%= lead.estimated_audience_size === s ? 'selected' : '' %>><%= s %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Budget Range</label>
                                <input type="text" name="budget_range" value="<%= lead.budget_range || '' %>">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Inquiry Message / Notes</label>
                            <textarea name="message" rows="4"><%= lead.message || '' %></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <button type="button" class="btn btn-outline" onclick="toggleEdit()">Cancel</button>
                        </div>
                    </form>
                </div>

                <!-- MESSAGE THREAD -->
                <div class="panel">
                    <h2 class="panel-title">Communications Thread</h2>
                    <div class="message-thread">
                        <% if (lead.message) { %>
                            <div class="msg inbound">
                                <div class="msg-meta">
                                    <span>Web Inquiry / Inbound Message</span>
                                    <span><%= new Date(lead.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %></span>
                                </div>
                                <div style="white-space: pre-wrap;"><%= lead.message %></div>
                            </div>
                        <% } %>

                        <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
                            <% messages.forEach(msg => { %>
                                <div class="msg <%= msg.direction %>">
                                    <div class="msg-meta">
                                        <span><%= msg.channel ? msg.channel.toUpperCase() : 'NOTE' %> (<%= msg.direction %>)</span>
                                        <span><%= new Date(msg.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %></span>
                                    </div>
                                    <div style="white-space: pre-wrap;"><%= msg.body %></div>
                                </div>
                            <% }) %>
                        <% } %>

                        <% if (!lead.message && (!messages || messages.length === 0)) { %>
                            <div style="text-align: center; padding: 2rem 0; color: var(--color-text-dim);">
                                No message transcripts recorded for this lead yet.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: NOTES & ACTIVITY TIMELINE -->
            <div>
                <!-- TEAM INTERNAL NOTES & FOLLOW-UP SCHEDULER -->
                <div class="panel" style="margin-bottom: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 0.75rem;">
                        <h2 class="panel-title" style="margin: 0; font-size: 1.15rem; display: flex; align-items: center; gap: 6px;">
                            📝 Internal Notes & Follow-Up
                        </h2>
                    </div>

                    <!-- Note Composer Form -->
                    <form id="leadPageNoteForm" onsubmit="event.preventDefault(); postLeadPageNote(<%= lead.id %>);" style="margin-bottom: 1.25rem;">
                        <div class="form-group" style="margin-bottom: 0.75rem;">
                            <textarea id="leadNoteText" rows="3" placeholder="Add confidential internal note regarding this deal..." required style="width: 100%; padding: 0.65rem 0.85rem; font-size: 0.84rem; background: #090907; border: 1px solid var(--color-border); border-radius: 8px; color: #fff;"></textarea>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; background: rgba(251, 246, 234, 0.02); padding: 0.6rem 0.75rem; border-radius: 8px; border: 1px dashed rgba(217, 162, 58, 0.25);">
                            <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-gold); font-weight: 700; text-transform: uppercase;">⏰ Schedule Follow-Up (Optional)</span>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <input type="date" id="leadFollowupDate" style="padding: 0.35rem 0.6rem; font-size: 0.78rem; background: #090907; border: 1px solid var(--color-border); border-radius: 6px; color: #fff;">
                                <input type="time" id="leadFollowupTime" value="14:00" style="padding: 0.35rem 0.6rem; font-size: 0.78rem; background: #090907; border: 1px solid var(--color-border); border-radius: 6px; color: #fff;">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.55rem; font-size: 0.82rem; font-weight: 700;">
                            + Post Note & Schedule Follow-Up
                        </button>
                    </form>

                    <!-- Notes Stream -->
                    <div id="leadNotesList" style="display: flex; flex-direction: column; gap: 0.65rem; max-height: 260px; overflow-y: auto;">
                        <% if (typeof notes !== 'undefined' && notes.length > 0) { %>
                            <% notes.forEach(n => { 
                                const authorName = n.author_name || 'Staff Member';
                                const initialChar = (authorName.trim().charAt(0) || 'U').toUpperCase();
                                const role = (n.author_role || 'staff').toUpperCase();
                                const timeStr = new Date(n.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                            %>
                                <div class="note-card" style="padding: 0.65rem 0.85rem; background: rgba(251, 246, 234, 0.03); border: 1px solid rgba(217, 162, 58, 0.15); border-radius: 8px; font-size: 0.82rem; display: flex; gap: 0.75rem; align-items: flex-start;">
                                    <div class="note-avatar" style="width: 28px; height: 28px; min-width: 28px; border-radius: 50%; background: linear-gradient(135deg, #1C1A14 0%, #29241B 100%); border: 1px solid var(--color-gold); color: var(--color-ivory); font-family: var(--font-serif); font-size: 0.85rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.4);">
                                        <%= initialChar %>
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; flex-wrap: wrap; gap: 0.4rem;">
                                            <div style="display: flex; align-items: center; gap: 0.45rem;">
                                                <span style="font-weight: 700; color: var(--color-ivory); font-size: 0.82rem;"><%= authorName %></span>
                                                <span style="display: inline-block; padding: 0.12rem 0.45rem; background: rgba(217, 162, 58, 0.12); border: 1px solid rgba(217, 162, 58, 0.35); border-radius: 100px; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-gold); letter-spacing: 0.05em; text-transform: uppercase;"><%= role %></span>
                                            </div>
                                            <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-dim);"><%= timeStr %></span>
                                        </div>
                                        <div style="color: rgba(251, 246, 234, 0.9); font-size: 0.84rem; line-height: 1.45; white-space: pre-wrap; word-break: break-word;"><%= n.note %></div>
                                        <% if (n.followup_at) { %>
                                            <div style="margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: rgba(217,162,58,0.15); border: 1px solid rgba(217,162,58,0.35); border-radius: 99px; font-size: 0.7rem; color: #D9A23A; font-family: var(--font-mono);">
                                                <span>⏰ Follow-up:</span> <strong><%= new Date(n.followup_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
                                                <% if (n.is_completed) { %><span style="color:#10b981; margin-left: 4px;">✓ Completed</span><% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div id="noLeadNotesNotice" style="color: var(--color-text-dim); font-size: 0.82rem; font-style: italic; padding: 0.5rem 0;">
                                No internal notes recorded yet.
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- AUDIT & ACTIVITY LOG -->
                <div class="panel">
                    <h2 class="panel-title">Audit & Activity Log</h2>
                    <div class="activity-feed">
                        <% if (typeof activity !== 'undefined' && activity.length > 0) { %>
                            <% activity.forEach(log => { %>
                                <div class="activity-item">
                                    <div class="activity-action"><%= log.action.replace(/_/g, ' ') %></div>
                                    <div class="activity-detail"><%= log.detail %></div>
                                    <div class="activity-time"><%= new Date(log.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %></div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="color: var(--color-text-dim); font-size: 0.9rem;">
                                No recent activity logged.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleEdit() {
            const viewMode = document.getElementById('view-mode');
            const editMode = document.getElementById('edit-mode');
            const toggleBtn = document.getElementById('editToggleBtn');

            if (editMode.style.display === 'none') {
                editMode.style.display = 'block';
                viewMode.style.display = 'none';
                toggleBtn.textContent = 'Cancel Edit';
            } else {
                editMode.style.display = 'none';
                viewMode.style.display = 'grid';
                toggleBtn.textContent = 'Edit Details';
            }
        }

        async function postLeadPageNote(leadId) {
            const textEl = document.getElementById('leadNoteText');
            const dateEl = document.getElementById('leadFollowupDate');
            const timeEl = document.getElementById('leadFollowupTime');
            const note = textEl ? textEl.value.trim() : '';
            if (!note) return;

            const followup_date = (dateEl && dateEl.value) ? dateEl.value : null;
            const followup_time = (timeEl && timeEl.value) ? timeEl.value : null;

            try {
                const res = await fetch(`/api/leads/${leadId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ note, followup_date, followup_time })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.error || 'Failed to post note');
                }
            } catch (err) {
                alert('Server error saving note');
            }
        }
    </script>
    <script src="/js/impact-os-cursor.js"></script>
</body>
</html>
