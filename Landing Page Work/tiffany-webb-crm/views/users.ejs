<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team & Access — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <style>
        .users-layout {
            display: grid;
            grid-template-columns: 1.8fr 1.2fr;
            gap: 2rem;
        }
        @media (max-width: 1024px) {
            .users-layout {
                grid-template-columns: 1fr;
            }
        }
        .role-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.65rem;
            border-radius: var(--radius-full);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .role-admin {
            background: rgba(217, 162, 58, 0.15);
            color: var(--color-gold);
            border: 1px solid rgba(217, 162, 58, 0.35);
        }
        .role-staff {
            background: rgba(56, 189, 248, 0.12);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.3);
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link">Website Studio</a>
            <a href="/users" class="nav-link active">Team & Access</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content" style="max-width: 1280px;">
        <div style="margin-bottom: 2rem;">
            <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                Access Governance
            </div>
            <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;">
                Team & <span class="italic-accent">Access</span>
            </h1>
            <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
                Control team member accounts, roles, administrative privileges, and security credentials.
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <div class="users-layout">
            <!-- LEFT: STAFF TABLE -->
            <div class="panel">
                <h2 class="panel-title" style="margin-bottom: 1.5rem;">Active Staff Accounts (<%= users.length %>)</h2>
                
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Name & Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th style="text-align: right;">Access Governance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600; color: var(--color-ivory);"><%= user.name %></div>
                                    <div style="font-size: 0.8rem; color: var(--color-text-dim); font-family: var(--font-mono);"><%= user.email %></div>
                                </td>
                                <td>
                                    <span class="role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-staff' %>">
                                        <%= user.role === 'admin' ? 'Admin' : (user.role === 'assistant' ? 'Assistant' : 'Staff') %>
                                    </span>
                                </td>
                                <td>
                                    <form action="/users/<%= user.id %>/toggle-status" method="POST" style="margin: 0; display: inline;">
                                        <% if (user.is_active) { %>
                                            <button type="submit" title="Click to Deactivate" class="status-pill active" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); padding: 0.25rem 0.65rem; font-size: 0.72rem; cursor: pointer; border-radius: 999px;">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: #34d399; display: inline-block; margin-right: 4px;"></span> Active
                                            </button>
                                        <% } else { %>
                                            <button type="submit" title="Click to Activate" class="status-pill inactive" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); padding: 0.25rem 0.65rem; font-size: 0.72rem; cursor: pointer; border-radius: 999px;">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: #f87171; display: inline-block; margin-right: 4px;"></span> Inactive
                                            </button>
                                        <% } %>
                                    </form>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: inline-flex; gap: 0.5rem; align-items: center;">
                                        <button type="button" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="openPasswordModal('<%= user.id %>', '<%= user.name %>')">
                                            Reset Password
                                        </button>

                                        <% if (user.is_active) { %>
                                            <form action="/users/<%= user.id %>/revoke-session" method="POST" style="margin: 0;" onsubmit="return confirm('Revoke all active sessions and access for <%= user.name %>?');">
                                                <button type="submit" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; border-color: rgba(239, 68, 68, 0.4); color: #f87171;">
                                                    Revoke Session
                                                </button>
                                            </form>
                                        <% } %>
                                        
                                        <% if (user.role !== 'admin' || (typeof currentUser !== 'undefined' && currentUser.id === user.id)) { %>
                                            <form action="/users/<%= user.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Permanently delete account for <%= user.name %>?');">
                                                <button type="submit" class="btn btn-ghost-danger" style="padding: 0.35rem 0.55rem; font-size: 0.75rem;">Delete</button>
                                            </form>
                                        <% } else { %>
                                            <span style="color: var(--color-text-dim); font-size: 0.72rem; font-family: var(--font-mono); padding: 0.35rem;" title="Admins cannot delete other Admins">Protected</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- RIGHT: CREATE STAFF FORM -->
            <div class="panel" style="height: fit-content;">
                <h2 class="panel-title" style="margin-bottom: 1.5rem;">Add New Staff</h2>
                <form action="/users" method="POST">
                    <div class="form-group">
                        <label>Staff Member Name</label>
                        <input type="text" name="name" required placeholder="e.g. Marcus Vance">
                    </div>

                    <div class="form-group">
                        <label>Work Email Address</label>
                        <input type="email" name="email" required placeholder="marcus@tiffanywebbimpact.com">
                    </div>

                    <div class="form-group">
                        <label>Security Role Assignment</label>
                        <select name="role">
                            <option value="assistant">Executive Assistant (Pipeline & Inbound)</option>
                            <option value="staff">Staff Member (General Pipeline Access)</option>
                            <option value="admin">Administrator (Full Access & Studio Management)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Initial Temporary Password</label>
                        <div style="position: relative;">
                            <input type="password" name="password" id="createStaffPassword" required placeholder="••••••••••••">
                            <button type="button" onclick="togglePasswordVisibility('createStaffPassword')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-gold); font-size: 0.9rem;">
                                👁️
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">+ Provision Staff Account</button>
                </form>
            </div>
        </div>
    </div>

    <!-- CHANGE PASSWORD MODAL -->
    <div id="passwordModal" style="display: none; position: fixed; inset: 0; background: rgba(13, 12, 8, 0.88); backdrop-filter: blur(10px); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem;">
        <div class="panel" style="width: 100%; max-width: 440px; margin: 0; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);">
            <h3 style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--color-ivory); margin: 0 0 0.25rem 0;">Change Password</h3>
            <p style="color: var(--color-text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Update credentials for <strong id="modalUserName" style="color: var(--color-gold);"></strong></p>
            
            <form id="passwordForm" method="POST">
                <div class="form-group">
                    <label>New Secure Password</label>
                    <div style="position: relative;">
                        <input type="password" name="new_password" id="changePasswordInput" required placeholder="••••••••••••">
                        <button type="button" onclick="togglePasswordVisibility('changePasswordInput')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-gold); font-size: 0.9rem;">
                            👁️
                        </button>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                    <button type="button" class="btn btn-outline" onclick="closePasswordModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save New Password</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(id) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
            } else {
                input.type = 'password';
            }
        }

        function openPasswordModal(userId, userName) {
            document.getElementById('modalUserName').innerText = userName;
            document.getElementById('passwordForm').action = `/users/${userId}/change-password`;
            document.getElementById('passwordModal').style.display = 'flex';
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').style.display = 'none';
            document.getElementById('changePasswordInput').value = '';
        }
    </script>
</body>
</html>
