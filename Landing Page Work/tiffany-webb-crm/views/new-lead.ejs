<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Lead — Tiffany Webb CRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        .tabs-header {
            display: flex;
            gap: 1rem;
            border-bottom: 1px solid var(--color-border-subtle);
            margin-bottom: 2rem;
        }
        .form-tab {
            padding: 0.85rem 1.5rem;
            background: transparent;
            border: none;
            color: var(--color-text-dim);
            font-family: var(--font-sans);
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }
        .form-tab:hover {
            color: var(--color-ivory);
        }
        .form-tab.active {
            color: var(--color-gold);
        }
        .form-tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--color-gold);
            box-shadow: 0 0 10px rgba(217, 162, 58, 0.6);
        }
        .dropzone-box {
            border: 2px dashed var(--color-border);
            border-radius: var(--radius-lg);
            padding: 3.5rem 2rem;
            text-align: center;
            background: var(--color-surface);
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .dropzone-box:hover {
            border-color: var(--color-gold);
            background: rgba(217, 162, 58, 0.04);
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>CRM</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link">Pipeline</a>
            <a href="/leads/new" class="nav-link active">Add Lead</a>
            <a href="/cms" class="nav-link">Website CMS</a>
            <a href="/users" class="nav-link">Staff</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content" style="max-width: 960px;">
        <div style="margin-bottom: 2rem;">
            <div class="crm-eyebrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                Inbound Lead Capture
            </div>
            <h1 class="page-title">Create New <span class="italic-accent">Inquiry</span></h1>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <!-- LIVE DUPLICATE WARNING BANNER -->
        <div id="duplicateWarningBox" style="display: none; background: rgba(217, 162, 58, 0.12); border: 1px solid var(--color-gold); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.3rem;">⚠️</span>
                    <div>
                        <div style="font-weight: 700; color: var(--color-gold); font-size: 0.92rem;">Potential Duplicate Lead Found</div>
                        <div id="duplicateDetails" style="font-size: 0.82rem; color: var(--color-ivory); margin-top: 0.2rem;"></div>
                    </div>
                </div>
                <a id="duplicateLeadLink" href="#" target="_blank" class="btn btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-color: var(--color-gold); color: var(--color-gold);">
                    View Existing Lead &rarr;
                </a>
            </div>
        </div>

        <div class="panel">
            <div class="tabs-header">
                <button type="button" class="form-tab active" onclick="switchTab('manual', this)">Manual Entry Form</button>
                <button type="button" class="form-tab" onclick="switchTab('batch', this)">Batch CSV / Excel Import</button>
            </div>

            <!-- MANUAL ENTRY TAB -->
            <div id="tab-manual">
                <form action="/api/leads" method="POST" id="manualLeadForm">
                    <input type="hidden" name="is_manual" value="true">

                    <div class="data-grid" style="margin-bottom: 0;">
                        <div class="form-group">
                            <label>Lead Source / Origin Channel</label>
                            <select name="source" id="sourceSelect">
                                <option value="website_form">Website Contact Form</option>
                                <option value="referral">Direct Executive Referral</option>
                                <option value="event">Conference / Live Event</option>
                                <option value="instagram">Instagram Inbound</option>
                                <option value="linkedin">LinkedIn Direct</option>
                                <option value="phone">Inbound Phone Call</option>
                                <option value="email">Direct Email Outreach</option>
                                <option value="other">Other Channel</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Specific Origin Trigger / Card</label>
                            <input type="text" name="source_card" placeholder="e.g., Keynote Card / Hero CTA">
                        </div>

                        <div class="form-group">
                            <label>Contact Full Name *</label>
                            <input type="text" name="contact_name" required placeholder="e.g. Dr. Eleanor Vance">
                        </div>

                        <div class="form-group">
                            <label>Organization / University</label>
                            <input type="text" name="organization_name" placeholder="e.g. Stanford Medical Institute">
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" id="leadEmailInput" placeholder="eleanor@stanford.edu" oninput="debounceDuplicateCheck()">
                        </div>

                        <div class="form-group">
                            <label>International Phone Number</label>
                            <div style="display: flex; gap: 0.5rem;">
                                <select name="country_code" style="width: 140px;">
                                    <option value="+1" selected>🇺🇸 +1 (US/CA)</option>
                                    <option value="+44">🇬🇧 +44 (UK)</option>
                                    <option value="+61">🇦🇺 +61 (AU)</option>
                                    <option value="+91">🇮🇳 +91 (IN)</option>
                                    <option value="+86">🇨🇳 +86 (CN)</option>
                                    <option value="+81">🇯🇵 +81 (JP)</option>
                                    <option value="+49">🇩🇪 +49 (DE)</option>
                                    <option value="+33">🇫🇷 +33 (FR)</option>
                                    <option value="+971">🇦🇪 +971 (AE)</option>
                                </select>
                                <input type="tel" name="phone" id="leadPhoneInput" placeholder="(555) 000-0000" oninput="debounceDuplicateCheck()">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Event Engagement Type</label>
                            <select name="event_type" id="eventTypeSelect" onchange="syncTopicDropdown(this.value)">
                                <option value="Conference Keynote">Conference Keynote</option>
                                <option value="Executive Boardroom">Executive Boardroom</option>
                                <option value="Healthcare Organization">Healthcare Organization</option>
                                <option value="University & Higher Ed">University & Higher Ed</option>
                                <option value="Workshop / Training">Workshop / Training</option>
                                <option value="Public Health / Non-Profit">Public Health / Non-Profit</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Topic Interest Track</label>
                            <select name="topic_interest" id="topicInterestSelect">
                                <option value="The Resilient Mindset">The Resilient Mindset</option>
                                <option value="Systems-Driven Healthcare">Systems-Driven Healthcare</option>
                                <option value="Modern High-Trust Leadership">Modern High-Trust Leadership</option>
                                <option value="Custom Executive Advisory">Custom Executive Advisory</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Target Event Date</label>
                            <input type="date" name="event_date">
                        </div>

                        <div class="form-group">
                            <label>Event Location / City</label>
                            <input type="text" name="event_location" placeholder="e.g. Boston, MA (or Virtual)">
                        </div>

                        <div class="form-group">
                            <label>Estimated Audience Size</label>
                            <select name="estimated_audience_size">
                                <option value="Under 50 attendees">Under 50 attendees</option>
                                <option value="50–150 attendees">50–150 attendees</option>
                                <option value="150–500 attendees">150–500 attendees</option>
                                <option value="500+ attendees">500+ attendees</option>
                                <option value="1,000+ Keynote">1,000+ Keynote</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Budget Allocation</label>
                            <input type="text" name="budget_range" placeholder="e.g. $10,000 - $25,000">
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 0.5rem;">
                        <label>Initial Inquiry Notes / Message</label>
                        <textarea name="message" rows="4" placeholder="Add specific inquiry context, introduction notes, or background..."></textarea>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
                        <a href="/dashboard" class="btn btn-outline">Cancel</a>
                        <button type="submit" class="btn btn-primary">+ Save Lead to Pipeline</button>
                    </div>
                </form>
            </div>

            <!-- BATCH CSV / EXCEL TAB -->
            <div id="tab-batch" style="display: none;">
                <div class="dropzone-box" onclick="document.getElementById('batchFileInput').click()">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="1.5" style="margin-bottom: 1rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <h3 style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--color-ivory); margin-bottom: 0.35rem;">Upload Spreadsheet</h3>
                    <p style="color: var(--color-text-muted); font-size: 0.88rem; max-width: 460px; margin: 0 auto 1.5rem auto;">
                        Drag and drop your .csv, .xlsx, or .xls file. Columns mapped: Contact Name, Email, Phone, Organization, Topic, Date.
                    </p>
                    <input type="file" id="batchFileInput" accept=".csv, .xlsx, .xls" style="display: none;" onchange="handleFileUpload(event)">
                    <button type="button" class="btn btn-outline">Select Local File</button>
                </div>

                <div id="batchPreviewArea" style="display: none; margin-top: 2rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <h4 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--color-ivory); margin: 0;">Parsed Leads (<span id="parsedCount" style="color: var(--color-gold);">0</span> found)</h4>
                        <button type="button" id="importBatchBtn" class="btn btn-primary" onclick="submitBatchImport()">Import All to Database</button>
                    </div>
                    <div style="max-height: 300px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: 8px;">
                        <table id="previewTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Organization</th>
                                    <th>Topic</th>
                                </tr>
                            </thead>
                            <tbody id="previewTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(mode, btn) {
            document.querySelectorAll('.form-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if (mode === 'manual') {
                document.getElementById('tab-manual').style.display = 'block';
                document.getElementById('tab-batch').style.display = 'none';
            } else {
                document.getElementById('tab-manual').style.display = 'none';
                document.getElementById('tab-batch').style.display = 'block';
            }
        }

        // Synced topic dropdown based on event type
        const topicMap = {
            'Conference Keynote': ['The Resilient Mindset', 'Systems-Driven Healthcare', 'Modern High-Trust Leadership', 'Custom Keynote Topic'],
            'Executive Boardroom': ['Modern High-Trust Leadership', 'Custom Executive Advisory', 'The Resilient Mindset', 'Healthcare Executive Strategy'],
            'Healthcare Organization': ['Systems-Driven Healthcare', 'The Resilient Mindset', 'Clinical & Operational Excellence', 'Custom Healthcare Workshop'],
            'University & Higher Ed': ['The Resilient Mindset', 'Modern High-Trust Leadership', 'Next-Gen Leadership Keynote', 'Student & Faculty Advisory'],
            'Workshop / Training': ['The Resilient Mindset (Interactive)', 'High-Trust Team Building', 'Operational Systems Sprint', 'Custom Hands-On Lab'],
            'Public Health / Non-Profit': ['Systems-Driven Healthcare', 'Community Resilience', 'Public Health Keynote', 'Non-Profit Governance']
        };

        function syncTopicDropdown(eventType) {
            const topicSelect = document.getElementById('topicInterestSelect');
            const topics = topicMap[eventType] || ['The Resilient Mindset', 'Systems-Driven Healthcare', 'Modern High-Trust Leadership', 'Custom Executive Advisory'];
            topicSelect.innerHTML = '';
            topics.forEach(topic => {
                const opt = document.createElement('option');
                opt.value = topic;
                opt.textContent = topic;
                topicSelect.appendChild(opt);
            });
        }

        // Real-time duplicate check with debouncing
        let duplicateTimeout = null;
        function debounceDuplicateCheck() {
            clearTimeout(duplicateTimeout);
            duplicateTimeout = setTimeout(checkDuplicateLead, 450);
        }

        async function checkDuplicateLead() {
            const email = (document.getElementById('leadEmailInput').value || '').trim();
            const phone = (document.getElementById('leadPhoneInput').value || '').trim();
            const warningBox = document.getElementById('duplicateWarningBox');
            const detailsDiv = document.getElementById('duplicateDetails');
            const leadLink = document.getElementById('duplicateLeadLink');

            if (!email && !phone) {
                warningBox.style.display = 'none';
                return;
            }

            try {
                const query = new URLSearchParams({ email, phone }).toString();
                const res = await fetch(`/api/leads/check-duplicate?${query}`);
                const data = await res.json();

                if (data.isDuplicate && data.lead) {
                    const l = data.lead;
                    detailsDiv.innerHTML = `Existing inquiry from <strong>${l.contact_name || 'Anonymous'}</strong> (${l.organization_name || 'Individual'}) is currently in <strong>${(l.status || 'new').toUpperCase()}</strong> stage.`;
                    leadLink.href = `/lead/${l.id}`;
                    warningBox.style.display = 'block';
                } else {
                    warningBox.style.display = 'none';
                }
            } catch (err) {
                console.error('Duplicate check error:', err);
            }
        }

        let parsedLeadsData = [];

        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const ext = file.name.split('.').pop().toLowerCase();
            if (ext === 'csv') {
                Papa.parse(file, {
                    header: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        processParsedData(results.data);
                    }
                });
            } else if (ext === 'xlsx' || ext === 'xls') {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.SheetNames[0];
                    const jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]);
                    processParsedData(jsonData);
                };
                reader.readAsArrayBuffer(file);
            }
        }

        function processParsedData(data) {
            parsedLeadsData = data.map(row => ({
                contact_name: row['Name'] || row['Contact Name'] || row['contact_name'] || row['Full Name'] || 'Unknown',
                email: row['Email'] || row['email'] || '',
                phone: row['Phone'] || row['phone'] || '',
                organization_name: row['Organization'] || row['Company'] || row['organization_name'] || '',
                topic_interest: row['Topic'] || row['topic_interest'] || '',
                event_date: row['Date'] || row['event_date'] || null,
                message: row['Message'] || row['message'] || ''
            }));

            const tbody = document.getElementById('previewTableBody');
            tbody.innerHTML = '';
            parsedLeadsData.forEach(lead => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${lead.contact_name}</td>
                    <td>${lead.email}</td>
                    <td>${lead.phone}</td>
                    <td>${lead.organization_name}</td>
                    <td>${lead.topic_interest}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('parsedCount').innerText = parsedLeadsData.length;
            document.getElementById('batchPreviewArea').style.display = 'block';
        }

        async function submitBatchImport() {
            if (parsedLeadsData.length === 0) return;
            const btn = document.getElementById('importBatchBtn');
            btn.disabled = true;
            btn.textContent = 'Importing...';

            try {
                const res = await fetch('/api/leads/batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leads: parsedLeadsData })
                });
                const result = await res.json();
                if (result.success) {
                    window.location.href = '/dashboard?success=' + encodeURIComponent(`Successfully imported ${result.count} leads!`);
                } else {
                    alert(result.error || 'Failed to import batch');
                    btn.disabled = false;
                    btn.textContent = 'Import All to Database';
                }
            } catch (err) {
                alert('Server error processing batch');
                btn.disabled = false;
                btn.textContent = 'Import All to Database';
        }
    </script>
</body>
</html>
