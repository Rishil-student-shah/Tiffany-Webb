<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Recovery — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
</head>
<body class="auth-page">

    <div class="auth-card">
        <div class="auth-logo-area">
            <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 0.5rem;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                Password Recovery
            </div>
            <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.2rem; color: #FBF6EA; margin-bottom: 0.5rem;">
                Recover <span class="italic-accent">Access</span>
            </h1>
            <p style="color: var(--color-text-muted); font-size: 0.88rem;">
                Enter your authorized account email. We will send a secure 6-digit OTP to reset your password.
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <form action="/forgot-password" method="POST">
            <div class="form-group">
                <label>Account Email Address</label>
                <input type="email" name="email" required placeholder="booking@tiffanywebbimpact.com">
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem; padding: 0.85rem;">
                Send 6-Digit OTP &rarr;
            </button>

            <div style="text-align: center; margin-top: 1.5rem;">
                <a href="/login" style="color: var(--color-text-dim); text-decoration: none; font-size: 0.82rem;">&larr; Back to Login</a>
            </div>
        </form>
    </div>
</body>
</html>
