<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Login — Tiffany Webb CRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
</head>
<body class="auth-page">

    <div class="auth-card">
        <div class="auth-logo-area">
            <div class="crm-eyebrow" style="margin-bottom: 0.5rem; justify-content: center;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                Secure Executive Portal
            </div>
            <h1 class="page-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                Tiffany Webb <span class="italic-accent">CRM</span>
            </h1>
            <p style="color: var(--color-text-muted); font-size: 0.88rem;">
                Enter your authorized credentials to access the executive suite.
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Authorized Email Address</label>
                <input type="email" name="email" required placeholder="admin@tiffanywebb.com" autocomplete="username">
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <label>Password</label>
                    <a href="/forgot-password" style="font-size: 0.75rem; color: var(--color-gold); text-decoration: none; font-family: var(--font-mono);">Forgot?</a>
                </div>
                <div style="position: relative;">
                    <input type="password" name="password" id="loginPassword" required placeholder="••••••••••••" autocomplete="current-password">
                    <button type="button" onclick="togglePasswordVisibility('loginPassword')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-gold); font-size: 0.9rem;">
                        👁️
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem; padding: 0.85rem;">
                Enter Executive Suite &rarr;
            </button>
        </form>
    </div>

    <script>
        function togglePasswordVisibility(id) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
            } else {
                input.type = 'password';
            }
        }
    </script>
</body>
</html>
