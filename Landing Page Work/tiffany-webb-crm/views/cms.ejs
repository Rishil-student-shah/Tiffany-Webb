<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Studio — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <style>
        .page-card {
            background: var(--color-card);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.5rem 1.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
            color: inherit;
            margin-bottom: 1rem;
        }
        .page-card:hover {
            transform: translateY(-2px);
            border-color: rgba(217, 162, 58, 0.45);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55), 0 0 20px rgba(217, 162, 58, 0.08);
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.35rem 0.85rem;
            border-radius: var(--radius-full);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
        }
        .status-pill.active {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.35);
        }
        .status-pill.inactive {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.35);
        }
        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 8px currentColor;
        }
    </style>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link active">Website Studio</a>
            <a href="/users" class="nav-link">Team & Access</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content" style="max-width: 1200px;">
        <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D9A23A; box-shadow: 0 0 10px #D9A23A;"></span>
                    Astro SSR Content Studio
                </div>
                <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;">
                    Website <span class="italic-accent">Studio</span>
                </h1>
                <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.35rem;">
                    Manage real-time copy, testimonials, collections, and media for all live website routes.
                </p>
            </div>
            <div>
                <a href="http://localhost:4321" target="_blank" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Open Live Site
                </a>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <% 
        const order = ['home', 'about', 'services', 'speaking-topics', 'impact', 'media', 'work-with-tiffany', 'insights', 'newsletter', 'navbar', 'privacy', 'terms'];
        pages.sort((a, b) => {
            let indexA = order.indexOf(a.slug);
            let indexB = order.indexOf(b.slug);
            if (indexA === -1) indexA = 99;
            if (indexB === -1) indexB = 99;
            return indexA - indexB;
        });
        %>

        <div class="panel" style="padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding: 0 0.5rem;">
                <span class="data-label">Available Editable Routes (<%= pages.length %>)</span>
                <span class="data-label">Status & Editor Actions</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <% pages.forEach(page => { 
                    const isActive = typeof page.is_active === 'undefined' || page.is_active;
                    const previewUrl = page.slug === 'home' ? 'http://localhost:4321' : `http://localhost:4321/${page.slug}`;
                %>
                    <div class="page-card">
                        <div style="display: flex; align-items: center; gap: 1.25rem;">
                            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(217, 162, 58, 0.1); border: 1px solid rgba(217, 162, 58, 0.25); display: flex; align-items: center; justify-content: center; color: var(--color-gold);">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                            </div>
                            <div>
                                <h3 style="font-family: var(--font-serif); font-size: 1.45rem; color: var(--color-ivory); margin: 0; line-height: 1.2;">
                                    <%= page.name %>
                                </h3>
                                <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim);">
                                    /<%= page.slug === 'home' ? '' : page.slug %>
                                </span>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <!-- Live status switcher -->
                            <button onclick="togglePageStatus(<%= page.id %>, <%= isActive ? 1 : 0 %>)" class="status-pill <%= isActive ? 'active' : 'inactive' %>" title="Click to toggle route visibility">
                                <span class="status-dot"></span>
                                <%= isActive ? 'Active' : 'Inactive' %>
                            </button>

                            <!-- Direct Preview Link -->
                            <a href="<%= previewUrl %>" target="_blank" class="btn btn-outline" style="padding: 0.45rem 0.9rem; font-size: 0.8rem;" title="Preview page on frontend">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Preview
                            </a>

                            <!-- Edit CMS Page Link -->
                            <a href="/cms/<%= page.slug %>" class="btn btn-primary" style="padding: 0.45rem 1.1rem; font-size: 0.82rem;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Edit Content
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        async function togglePageStatus(pageId, currentStatus) {
            const newStatus = currentStatus ? 0 : 1;
            try {
                const res = await fetch(`/api/pages/${pageId}/toggle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ is_active: newStatus })
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to update page status');
                }
            } catch (e) {
                alert('Error connecting to server');
            }
        }
    </script>
    <script src="/js/impact-os-cursor.js"></script>
</body>
</html>
