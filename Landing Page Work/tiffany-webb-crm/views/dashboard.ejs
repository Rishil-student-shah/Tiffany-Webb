<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pipeline Dashboard — Tiffany Webb CRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>CRM</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link active">Pipeline</a>
            <a href="/leads/new" class="nav-link">Add Lead</a>
            <a href="/cms" class="nav-link">Website CMS</a>
            <a href="/users" class="nav-link">Staff</a>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <div class="main-content">
        <!-- HEADER & KEYLINES -->
        <div style="margin-bottom: 2rem;">
            <div class="crm-eyebrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                Executive Booking Suite
            </div>
            <h1 class="page-title">Booking <span class="italic-accent">Pipeline</span></h1>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <!-- KPI STRIP -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-value"><%= leads.length %></span>
                <span class="stat-label">Total Pipeline Inquiries</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" style="color: var(--color-gold) !important;"><%= leads.filter(l => l.status === 'new').length %></span>
                <span class="stat-label">New / Unread</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" style="color: var(--color-terracotta) !important;"><%= leads.filter(l => l.status === 'proposal_sent').length %></span>
                <span class="stat-label">Proposals Out</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" style="color: #10b981 !important;"><%= leads.filter(l => l.status === 'booked').length %></span>
                <span class="stat-label">Confirmed Engagements</span>
            </div>
        </div>

        <!-- CHARTS ROW -->
        <div class="charts-row">
            <div class="chart-card">
                <h3>Lead Sources</h3>
                <div style="height: 240px; display: flex; justify-content: center; align-items: center;">
                    <canvas id="sourceChart"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <h3>Pipeline Funnel Conversion</h3>
                <div style="height: 240px;">
                    <canvas id="funnelChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ACTION BAR -->
        <div class="action-bar">
            <div style="display: flex; gap: 0.75rem; flex: 1; max-width: 500px;">
                <input type="text" id="searchInput" class="search-input" placeholder="Search leads by contact, organization, email...">
                <button id="searchBtn" class="btn btn-primary" onclick="performSearch()">Search</button>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center;">
                <button class="btn btn-ghost-danger" onclick="bulkDelete('all')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Purge All Leads
                </button>
                <a href="/leads/new" class="btn btn-primary">+ Add New Lead</a>
            </div>
        </div>

        <!-- SEARCH RESULTS CONTAINER -->
        <div id="searchResultsContainer" style="display: none; background: var(--color-card); border: 1px solid var(--color-border); border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-ivory);">Search Results <span id="searchResultCount" style="color: var(--color-gold); font-size: 1rem; font-family: var(--font-mono); font-weight: normal; margin-left: 0.5rem;"></span></h3>
                <button onclick="clearSearch()" class="btn btn-outline" style="padding: 0.4rem 1rem;">Clear Search</button>
            </div>
            <div id="searchResultsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
            </div>
        </div>

        <!-- 8-STAGE KANBAN NAVIGATION TABS -->
        <div class="premium-nav" id="kanbanTabs">
            <% 
            const statuses = ['new', 'contacted', 'qualified', 'proposal_sent', 'booked', 'completed', 'declined', 'lost'];
            statuses.forEach((status, i) => { 
                const count = leads.filter(l => l.status === status).length;
            %>
                <button id="tab-btn-<%= status %>" class="premium-tab <%= i === 0 ? 'active' : '' %>" onclick="showTab('<%= status %>')">
                    <%= status.replace('_', ' ') %>
                    <span class="premium-badge"><%= count %></span>
                </button>
            <% }) %>
        </div>

        <!-- STAGES PANES -->
        <div class="tab-content-wrapper" id="kanban-wrapper">
            <% 
            statuses.forEach((status, i) => { 
                const colLeads = leads.filter(l => l.status === status);
            %>
                <div id="tab-pane-<%= status %>" class="tab-pane" style="display: <%= i === 0 ? 'block' : 'none' %>;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem;">
                        <div>
                            <h2 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--color-ivory); margin: 0; text-transform: capitalize;">
                                <%= status.replace('_', ' ') %> <span class="italic-accent">Stage</span>
                            </h2>
                            <p style="color: var(--color-text-muted); font-size: 0.88rem; margin-top: 0.25rem;">
                                Inquiries currently in <%= status.replace('_', ' ') %> stage (<%= colLeads.length %> total).
                            </p>
                        </div>
                        <% if (colLeads.length > 0) { %>
                            <button onclick="bulkDelete('<%= status %>')" class="btn-ghost-danger">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg>
                                Clear <%= status.replace('_', ' ') %>
                            </button>
                        <% } %>
                    </div>
                    
                    <% if (colLeads.length === 0) { %>
                        <div style="background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: 12px; padding: 3.5rem 2rem; text-align: center; color: var(--color-text-muted);">
                            <p style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-ivory); margin-bottom: 0.5rem;">No Leads in <%= status.replace('_', ' ') %></p>
                            <p style="font-size: 0.88rem;">New inquiries will appear here automatically when moved to this stage.</p>
                        </div>
                    <% } else { %>
                        <div class="leads-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
                            <% colLeads.forEach(lead => { %>
                                <div class="glass-card lead-card-item" data-search="<%= (lead.contact_name || '') + ' ' + (lead.email || '') + ' ' + (lead.phone || '') + ' ' + (lead.organization_name || '') + ' ' + (lead.source || '') %>" onclick="window.location.href='/lead/<%= lead.id %>'">
                                    <div class="gc-header">
                                        <h3 class="gc-title"><%= lead.contact_name || lead.phone || 'Unknown Lead' %></h3>
                                        <span class="gc-date"><%= lead.event_date ? new Date(lead.event_date).toLocaleDateString(undefined, {month: 'short', day: 'numeric'}) : 'TBD' %></span>
                                    </div>
                                    <p class="gc-org"><%= lead.organization_name || 'Individual / General Inquiry' %></p>
                                    
                                    <div class="gc-footer">
                                        <div class="gc-tag">
                                            <span class="gc-dot"></span>
                                            <span class="gc-tag-text"><%= lead.source_card || lead.source_section || lead.source.replace('_', ' ') %></span>
                                        </div>
                                        <div class="gc-arrow">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- SCRIPT & CHARTS -->
    <script>
        const chartData = <%- chartData %>;
        
        // 1. Source Doughnut Chart
        const sourceCtx = document.getElementById('sourceChart').getContext('2d');
        const sourceLabels = Object.keys(chartData.sourceData).map(s => s.replace('_', ' '));
        const sourceValues = Object.values(chartData.sourceData);
        
        new Chart(sourceCtx, {
            type: 'doughnut',
            data: {
                labels: sourceLabels.length > 0 ? sourceLabels : ['Direct'],
                datasets: [{
                    data: sourceValues.length > 0 ? sourceValues : [1],
                    backgroundColor: ['#D9A23A', '#E17356', '#6C2D5A', '#10B981', '#38BDF8'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#FBF6EA',
                            font: { family: 'Plus Jakarta Sans', size: 12 },
                            padding: 15
                        }
                    }
                },
                cutout: '68%'
            }
        });

        // 2. Funnel Bar Chart (Signature Luxury Gradient)
        const funnelCtx = document.getElementById('funnelChart').getContext('2d');
        const barGradient = funnelCtx.createLinearGradient(0, 0, 0, 240);
        barGradient.addColorStop(0, '#D9A23A');
        barGradient.addColorStop(1, '#6C2D5A');

        new Chart(funnelCtx, {
            type: 'bar',
            data: {
                labels: ['New', 'Qualified', 'Proposal Sent', 'Booked'],
                datasets: [{
                    label: 'Leads',
                    data: [
                        chartData.funnelData.new || 0, 
                        chartData.funnelData.qualified || 0, 
                        chartData.funnelData.proposal_sent || 0, 
                        chartData.funnelData.booked || 0
                    ],
                    backgroundColor: barGradient,
                    borderRadius: 8,
                    maxBarThickness: 45
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { color: 'rgba(251, 246, 234, 0.6)', stepSize: 1, font: { family: 'JetBrains Mono' } },
                        grid: { color: 'rgba(251, 246, 234, 0.05)' }
                    },
                    x: {
                        ticks: { color: '#FBF6EA', font: { family: 'Plus Jakarta Sans', weight: '600' } },
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // Tab Switching
        function showTab(status) {
            document.querySelectorAll('.tab-pane').forEach(pane => pane.style.display = 'none');
            const targetPane = document.getElementById('tab-pane-' + status);
            if (targetPane) targetPane.style.display = 'block';
            
            document.querySelectorAll('.premium-tab').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById('tab-btn-' + status);
            if (activeBtn) activeBtn.classList.add('active');
        }

        // Search Filtering Logic
        const searchInput = document.getElementById('searchInput');
        const searchResultsContainer = document.getElementById('searchResultsContainer');
        const searchResultsGrid = document.getElementById('searchResultsGrid');
        const searchResultCount = document.getElementById('searchResultCount');
        const kanbanWrapper = document.getElementById('kanban-wrapper');
        const kanbanTabs = document.getElementById('kanbanTabs');

        function performSearch() {
            const query = (searchInput.value || '').toLowerCase().trim();
            if (!query) {
                clearSearch();
                return;
            }

            const cards = document.querySelectorAll('.lead-card-item');
            searchResultsGrid.innerHTML = '';
            let count = 0;

            cards.forEach(card => {
                const searchData = (card.getAttribute('data-search') || '').toLowerCase();
                if (searchData.includes(query)) {
                    const clone = card.cloneNode(true);
                    searchResultsGrid.appendChild(clone);
                    count++;
                }
            });

            if (count === 0) {
                searchResultsGrid.innerHTML = '<p style="color: var(--color-text-muted); grid-column: 1 / -1; padding: 2rem 0; text-align: center;">No leads found matching your search query.</p>';
                searchResultCount.textContent = '(0 found)';
            } else {
                searchResultCount.textContent = `(${count} found)`;
            }

            searchResultsContainer.style.display = 'block';
            kanbanWrapper.style.display = 'none';
            kanbanTabs.style.display = 'none';
        }

        function clearSearch() {
            searchInput.value = '';
            searchResultsContainer.style.display = 'none';
            kanbanWrapper.style.display = 'block';
            kanbanTabs.style.display = 'flex';
        }

        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') performSearch();
            });
            searchInput.addEventListener('input', function(e) {
                if (e.target.value.trim() === '') clearSearch();
            });
        }

        // Bulk Delete API
        async function bulkDelete(status) {
            const isAll = status === 'all';
            const msg = isAll 
                ? "Are you absolutely certain you want to purge ALL leads from the system? This action cannot be reversed."
                : `Are you sure you want to delete all leads in the '${status.replace('_', ' ')}' stage?`;
            
            if (confirm(msg)) {
                try {
                    const response = await fetch('/api/leads/bulk-delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status })
                    });
                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                    } else {
                        alert(result.error || 'Failed to delete leads');
                    }
                } catch (err) {
                    alert('Error communicating with server');
                }
            }
        }
    </script>
</body>
</html>
