<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pipeline Ledger — Tiffany Webb Impact OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/crm-theme.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <!-- UNIFIED TOP NAVIGATION -->
    <nav class="top-nav">
        <a href="/dashboard" class="nav-brand">
            <h1 class="nav-logo">Tiffany Webb <span>Impact OS</span></h1>
        </a>
        <div class="nav-links">
            <a href="/dashboard" class="nav-link active">Pipeline Ledger</a>
            <a href="/leads/new" class="nav-link">+ Log Inbound</a>
            <a href="/cms" class="nav-link">Website Studio</a>
            <a href="/users" class="nav-link">Team & Access</a>
            <button onclick="openGuideModal()" class="btn btn-ghost" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; border: 1px solid rgba(217,162,58,0.3); color: #D9A23A; cursor: pointer; background: transparent; border-radius: 6px;">
                📖 Guide Me
            </button>
            <span class="nav-pill">Admin</span>
            <a href="/logout" class="nav-link" style="color: #ef4444 !important;">Logout</a>
        </div>
    </nav>

    <!-- Guide Me Modal -->
    <div id="guideModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(8px);" onclick="if(event.target===this)closeGuideModal()">
        <div class="card-elite" style="max-width: 650px; width: 90%; max-height: 85vh; overflow-y: auto; border-radius: 16px; padding: 2rem; border: 1px solid rgba(217,162,58,0.3); background: #12100C;" onclick="event.stopPropagation()">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(217,162,58,0.15); padding-bottom: 1rem;">
                <h2 style="font-family: var(--font-serif); font-size: 1.5rem; color: #FBF6EA; margin: 0;">Impact OS™ <span class="italic-accent">Role Playbook</span></h2>
                <button onclick="closeGuideModal()" style="background: none; border: none; color: #FBF6EA; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>
            <!-- Role Tabs -->
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
                <button onclick="switchGuideTab('staff')" id="guide-tab-staff" class="tab-btn active" style="padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8rem; font-weight: 600; cursor: pointer; background: rgba(217,162,58,0.15); color: #D9A23A; border: 1px solid rgba(217,162,58,0.3);">Staff Member</button>
                <button onclick="switchGuideTab('assistant')" id="guide-tab-assistant" class="tab-btn" style="padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8rem; font-weight: 600; cursor: pointer; background: transparent; color: rgba(251,246,234,0.6); border: 1px solid rgba(255,255,255,0.1);">Executive Assistant</button>
                <button onclick="switchGuideTab('admin')" id="guide-tab-admin" class="tab-btn" style="padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8rem; font-weight: 600; cursor: pointer; background: transparent; color: rgba(251,246,234,0.6); border: 1px solid rgba(255,255,255,0.1);">Admin (Tiffany)</button>
            </div>
            <!-- Role Contents -->
            <div id="guide-content-staff" class="guide-panel" style="font-size: 0.85rem; color: rgba(251,246,234,0.75); line-height: 1.7;">
                <h4 style="color: #D9A23A; font-weight: 700; margin-bottom: 0.5rem;">Staff Member Workflow</h4>
                <p>• <strong>Event Logistics:</strong> Check confirmed event dates, locations, and honorarium notes.</p>
                <p>• <strong>Internal Notes:</strong> Click the chevron on any lead row to log call notes or briefing updates.</p>
                <p>• <strong>Access Boundaries:</strong> Read-only access to financial records and system configuration.</p>
            </div>
            <div id="guide-content-assistant" class="guide-panel" style="display: none; font-size: 0.85rem; color: rgba(251,246,234,0.75); line-height: 1.7;">
                <h4 style="color: #38bdf8; font-weight: 700; margin-bottom: 0.5rem;">Executive Assistant Workflow</h4>
                <p>• <strong>Lead Triage:</strong> Triage new inbound inquiries in the 1-Row Ledger. Use the 1-Click WhatsApp or Email buttons for instant outreach.</p>
                <p>• <strong>Stage Transitions:</strong> Update pipeline stages (e.g. from <em>New Inquiries</em> to <em>Discovery Call</em> or <em>Proposal Sent</em>).</p>
                <p>• <strong>Batch Import:</strong> Upload conference attendee spreadsheets via <em>+ Log Inbound</em> -> <em>Batch Import</em>.</p>
            </div>
            <div id="guide-content-admin" class="guide-panel" style="display: none; font-size: 0.85rem; color: rgba(251,246,234,0.75); line-height: 1.7;">
                <h4 style="color: #10b981; font-weight: 700; margin-bottom: 0.5rem;">Master Administrator (Tiffany) Privileges</h4>
                <p>• <strong>Full Team & Access Control:</strong> Manage staff/assistant accounts in <em>Team & Access</em>. Deactivate users with immediate session revocation.</p>
                <p>• <strong>Website Studio (Live CMS):</strong> Edit any page text, upload video reels (up to 60MB), and update speaking topics in real-time.</p>
                <p>• <strong>Financial & Revenue Ledger:</strong> View confirmed earnings and track contract deposits.</p>
            </div>
        </div>
    </div>

    <div class="main-content">
        <!-- HEADER & KEYLINES -->
        <div style="margin-bottom: 2rem;">
            <div class="crm-eyebrow" style="color: #D9A23A !important; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                <span class="pulse-dot"></span>
                Executive Command & Deal Flow
            </div>
            <h1 class="page-title" style="font-family: var(--font-serif); font-size: 2.75rem; color: #FBF6EA; margin-top: 0.35rem;">
                Executive <span class="italic-accent">Pipeline Ledger</span>
            </h1>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span><%= error %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <span><%= success %></span>
                <button onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>
        <% } %>

        <!-- KPI STRIP -->
        <div class="stats-grid">
            <div class="stat-card stat-card-revenue">
                <span class="stat-value" id="kpi-revenue" style="color: #D9A23A !important;">$<%= Number(typeof totalConfirmedRevenue !== 'undefined' ? totalConfirmedRevenue : 0).toLocaleString('en-US') %></span>
                <span class="stat-label">Confirmed Revenue</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-total-leads"><%= (leads || []).length %></span>
                <span class="stat-label">Total Inquiries</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-new-leads" style="color: var(--color-gold) !important;"><%= (leads || []).filter(l => l.status === 'new').length %></span>
                <span class="stat-label">New / Unread</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-proposal-leads" style="color: var(--color-terracotta) !important;"><%= (leads || []).filter(l => l.status === 'proposal_sent').length %></span>
                <span class="stat-label">Proposals Out</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-booked-leads" style="color: #10b981 !important;"><%= (leads || []).filter(l => l.status === 'booked').length %></span>
                <span class="stat-label">Confirmed Booked</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-completed-leads" style="color: #38bdf8 !important;"><%= (leads || []).filter(l => l.status === 'completed').length %></span>
                <span class="stat-label">Completed Events</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-declined-leads" style="color: var(--color-text-dim) !important;"><%= (leads || []).filter(l => l.status === 'declined').length %></span>
                <span class="stat-label">Declined</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="kpi-lost-leads" style="color: #ef4444 !important;"><%= (leads || []).filter(l => l.status === 'lost').length %></span>
                <span class="stat-label">Lost</span>
            </div>
        </div>

        <!-- CHARTS ROW -->
        <div class="charts-row">
            <div class="chart-card">
                <h3>Lead Sources</h3>
                <div style="height: 240px; display: flex; justify-content: center; align-items: center;">
                    <canvas id="sourceChart"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <h3>Pipeline Funnel Conversion</h3>
                <div style="height: 240px;">
                    <canvas id="funnelChart"></canvas>
                </div>
            </div>
        </div>

        <!-- EXECUTIVE STATUS STICKY NAVBAR -->
        <div class="executive-navbar-sticky" id="statusNavbar">
            <!-- Stage Tabs -->
            <div class="status-tabs-container" id="statusTabsNav">
                <% 
                const filterTabs = [
                    { id: 'all', label: 'All Deals' },
                    { id: 'new', label: 'New Inquiries' },
                    { id: 'contacted', label: 'Discovery Call' },
                    { id: 'qualified', label: 'Qualified ($5k+)' },
                    { id: 'proposal_sent', label: 'Proposal Sent' },
                    { id: 'booked', label: 'Confirmed Booked' },
                    { id: 'completed', label: 'Completed' },
                    { id: 'declined', label: 'Declined' },
                    { id: 'lost', label: 'Lost' }
                ];
                filterTabs.forEach((tab, index) => { 
                    const count = tab.id === 'all' 
                        ? (leads ? leads.length : 0) 
                        : (leads ? leads.filter(l => l.status === tab.id).length : 0);
                %>
                    <button class="status-tab-btn <%= index === 0 ? 'active' : '' %>" data-tab-stage="<%= tab.id %>" onclick="filterLedger('<%= tab.id %>')">
                        <span><%= tab.label %></span>
                        <span class="status-pill-count" id="count-tab-<%= tab.id %>"><%= count %></span>
                    </button>
                <% }) %>
            </div>

            <!-- Real-time Instant Search & Actions -->
            <div class="navbar-actions-group" style="display: flex; align-items: center; gap: 1rem;">
                <div class="navbar-search-group">
                    <svg class="navbar-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#D9A23A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="ledgerSearchInput" class="navbar-search-input" placeholder="Search org, contact, topic, city..." oninput="handleLedgerSearch()">
                </div>
                <button class="btn btn-ghost-danger" onclick="bulkDeletePrompt()" style="white-space: nowrap; padding: 0.5rem 0.85rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Purge
                </button>
                <a href="/leads/new" class="btn btn-primary" style="white-space: nowrap; padding: 0.5rem 1rem; font-size: 0.85rem;">+ Log Inbound</a>
            </div>
        </div>

        <!-- CONTINUOUS 1-ROW-PER-LEAD TABLE / LEDGER -->
        <div class="ledger-container" id="ledgerContainer">
            <!-- Header Row -->
            <div class="ledger-table-header">
                <div>Organization & Contact</div>
                <div>Origin & Topic</div>
                <div>Event Details</div>
                <div>Honorarium</div>
                <div>Pipeline Stage</div>
                <div style="text-align: right;">Actions</div>
            </div>

            <!-- Leads Rows List -->
            <div id="ledgerRowsList">
                <% if (!leads || leads.length === 0) { %>
                    <div id="ledgerEmptyState" style="padding: 4rem 2rem; text-align: center; color: var(--color-text-muted);">
                        <p style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--color-ivory); margin-bottom: 0.5rem;">No Inquiries in new / current pipeline stage</p>
                        <p style="font-size: 0.9rem;">New client inquiries from the website will automatically appear in this ledger.</p>
                    </div>
                <% } else { %>
                    <% leads.forEach(lead => { 
                        const org = lead.organization_name || 'Individual / General Inquiry';
                        const contact = lead.contact_name || lead.email || ('Inquiry #' + lead.id);
                        const initialChar = (lead.organization_name && lead.organization_name.trim().length > 0) 
                            ? lead.organization_name.trim().charAt(0).toUpperCase() 
                            : (lead.contact_name && lead.contact_name.trim().length > 0 
                                ? lead.contact_name.trim().charAt(0).toUpperCase() 
                                : 'L');
                        const originText = lead.source_card || lead.source_section || (lead.source ? lead.source.replace('_', ' ') : 'Website Form');
                        const topicText = lead.topic_interest || lead.event_type || 'Keynote Presentation';
                        const dateFormatted = lead.event_date ? new Date(lead.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date TBD';
                        const submitTime = lead.created_at ? new Date(lead.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Recent';
                        const budget = lead.budget_range || '$5k–$10k';
                        const cleanPhone = (lead.phone || '').replace(/[^0-9]/g, '');
                        let waPhone = cleanPhone;
                        if (lead.country_code) {
                            const cleanCC = lead.country_code.replace(/[^0-9]/g, '');
                            if (cleanCC && !cleanPhone.startsWith(cleanCC)) {
                                waPhone = cleanCC + cleanPhone;
                            }
                        }
                        const searchTokens = [
                            lead.contact_name || '',
                            lead.organization_name || '',
                            lead.email || '',
                            lead.phone || '',
                            lead.event_location || '',
                            lead.topic_interest || '',
                            lead.event_type || '',
                            lead.source || '',
                            lead.source_section || '',
                            lead.source_card || '',
                            lead.budget_range || '',
                            lead.message || ''
                        ].join(' ').toLowerCase();
                    %>
                        <div class="ledger-item lead-card-<%= lead.id %> lead-row-<%= lead.id %>" 
                             id="lead-item-<%= lead.id %>" 
                             data-id="<%= lead.id %>" 
                             data-stage="<%= lead.status %>" 
                             data-fee="<%= lead.fee_amount || 0 %>" 
                             data-search="<%= searchTokens %>">
                            
                            <!-- 1-Row Grid -->
                            <div class="ledger-row" onclick="toggleDossier(<%= lead.id %>, event)">
                                <!-- Col 1: Initial Avatar + Org + Contact + Submit Time (3 cols) -->
                                <div class="ledger-col col-org-contact">
                                    <div class="ledger-avatar">
                                        <%= initialChar %>
                                    </div>
                                    <div class="lead-meta-text">
                                        <span class="lead-org-name" title="<%= org %>"><%= org %></span>
                                        <span class="lead-contact-person" title="<%= contact %>"><%= contact %></span>
                                        <span class="lead-submit-time">Submitted: <%= submitTime %></span>
                                        <% if (lead.active_followup) { %>
                                            <div class="followup-pill" style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: rgba(217,162,58,0.12); border: 1px solid rgba(217,162,58,0.3); border-radius: 99px; font-size: 0.72rem; color: #D9A23A; margin-top: 4px; width: fit-content;">
                                                <span>⏰</span> Follow-up: <%= lead.active_followup %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Col 2: Origin Badge + Section + Topic (3 cols) -->
                                <div class="ledger-col col-origin-topic">
                                    <div class="origin-badge" title="<%= originText %>">
                                        <span class="origin-badge-dot"></span>
                                        <span><%= originText %></span>
                                    </div>
                                    <span class="lead-topic-title" title="<%= topicText %>"><%= topicText %></span>
                                    <span class="lead-section-subtext" title="<%= lead.source_section || 'Direct Inbound' %>"><%= lead.source_section || 'Direct Inbound' %></span>
                                </div>

                                <!-- Col 3: Event Date + Location + Audience (2 cols) -->
                                <div class="ledger-col col-event-details">
                                    <span class="lead-event-date">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                        <%= dateFormatted %>
                                    </span>
                                    <span class="lead-event-loc" title="<%= lead.event_location || 'Location TBD' %>">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                        <%= lead.event_location || 'Location TBD' %>
                                    </span>
                                    <span class="lead-event-audience">
                                        Audience: <%= lead.estimated_audience_size ? lead.estimated_audience_size : 'TBD' %>
                                    </span>
                                </div>

                                <!-- Col 4: Gold Honorarium/Budget Pill (1 col) -->
                                <div class="ledger-col col-budget">
                                    <span class="badge-budget"><%= budget %></span>
                                </div>

                                <!-- Col 5: Inline Stage Dropdown with AJAX (2 cols) -->
                                <div class="ledger-col col-stage" onclick="event.stopPropagation()">
                                    <select class="stage-select" id="stage-select-<%= lead.id %>" onchange="updateLeadStage(<%= lead.id %>, this.value, event)">
                                        <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>New Inquiries</option>
                                        <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>Discovery Call</option>
                                        <option value="qualified" <%= lead.status === 'qualified' ? 'selected' : '' %>>Qualified ($5k+)</option>
                                        <option value="proposal_sent" <%= lead.status === 'proposal_sent' ? 'selected' : '' %>>Proposal Sent</option>
                                        <option value="booked" <%= lead.status === 'booked' ? 'selected' : '' %>>Confirmed Booked</option>
                                        <option value="completed" <%= lead.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                        <option value="declined" <%= lead.status === 'declined' ? 'selected' : '' %>>Declined</option>
                                        <option value="lost" <%= lead.status === 'lost' ? 'selected' : '' %>>Lost</option>
                                    </select>
                                </div>

                                <!-- Col 6: WhatsApp, Email & Expand Toggle (1 col) -->
                                <div class="ledger-col col-actions" onclick="event.stopPropagation()">
                                    <% if (waPhone) { %>
                                        <a href="https://wa.me/<%= waPhone %>" target="_blank" rel="noopener" class="action-icon-btn whatsapp" title="WhatsApp (+<%= waPhone %>)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                                        </a>
                                    <% } %>
                                    <% if (lead.email) { %>
                                        <a href="mailto:<%= lead.email %>" class="action-icon-btn email" title="Email (<%= lead.email %>)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#FBF6EA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                        </a>
                                    <% } %>
                                    <!-- 3rd Button: Toggle Executive Dossier with Visible Chevron -->
                                    <button type="button" class="action-icon-btn toggle-btn" title="Toggle Executive Dossier" onclick="toggleDossier(<%= lead.id %>, event)">
                                        <svg class="accordion-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A23A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: block; pointer-events: none;">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Inline Accordion Dossier Drawer -->
                            <div class="ledger-dossier" id="dossier-<%= lead.id %>">
                                <div class="dossier-grid">
                                    <!-- Left: Client Inquiry Message -->
                                    <div class="dossier-message-box">
                                        <div class="dossier-message-title">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                            Client Inquiry Message & Objectives
                                        </div>
                                        <div class="dossier-message-text"><%= lead.message || 'No additional inquiry message text submitted with this lead.' %></div>
                                    </div>

                                    <!-- Right: Attribution & Contact Details -->
                                    <div class="dossier-meta-card">
                                        <div>
                                            <div class="dossier-message-title" style="margin-bottom: 1rem;">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                                Attribution & Contact Metadata
                                            </div>
                                            <div class="dossier-meta-list">
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Channel Source</span>
                                                    <span class="dossier-meta-value"><%= (lead.source || 'website').replace('_', ' ') %></span>
                                                </div>
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Section Origin</span>
                                                    <span class="dossier-meta-value"><%= lead.source_section || 'General Web' %></span>
                                                </div>
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Card / Track</span>
                                                    <span class="dossier-meta-value"><%= lead.source_card || 'Keynote Presentation' %></span>
                                                </div>
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Direct Email</span>
                                                    <span class="dossier-meta-value"><%= lead.email || 'N/A' %></span>
                                                </div>
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Phone / WhatsApp</span>
                                                    <span class="dossier-meta-value"><%= lead.phone || 'N/A' %></span>
                                                </div>
                                                <div class="dossier-meta-item">
                                                    <span class="dossier-meta-label">Created Timestamp</span>
                                                    <span class="dossier-meta-value"><%= lead.created_at ? new Date(lead.created_at).toLocaleString() : 'N/A' %></span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Dossier Bottom Actions -->
                                        <div class="dossier-actions">
                                            <a href="/lead/<%= lead.id %>" class="btn btn-primary" style="padding: 0.45rem 1.1rem; font-size: 0.82rem;">
                                                Open Full Lead Dossier & Activity &rarr;
                                            </a>
                                            <button type="button" class="btn btn-ghost-danger" onclick="deleteSingleLead(<%= lead.id %>, event)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg>
                                                Delete Lead
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Team Internal Notes Hub & Follow-Up Scheduler -->
                                <div class="dossier-notes-section" style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgba(217, 162, 58, 0.15);">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                        <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;">
                                            📝 Team Internal Notes & Smart Follow-Up Scheduler
                                        </span>
                                    </div>
                                    <!-- Add Note Input Bar & Optional Follow-Up Scheduler -->
                                    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem;">
                                        <div style="display: flex; gap: 0.5rem;">
                                            <input type="text" id="note-input-<%= lead.id %>" placeholder="Add a private note about this client (visible to team & admin)..." style="flex: 1; padding: 0.5rem 0.85rem; font-size: 0.82rem; background: #090907; border: 1px solid var(--color-border); border-radius: 8px; color: #fff;" onkeydown="if(event.key==='Enter'){event.preventDefault();postLeadNote(<%= lead.id %>);}">
                                            <button type="button" class="btn btn-primary" onclick="postLeadNote(<%= lead.id %>)" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 700; white-space: nowrap;">
                                                + Post Note
                                            </button>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; background: rgba(251, 246, 234, 0.02); padding: 0.4rem 0.65rem; border-radius: 6px; border: 1px dashed rgba(217, 162, 58, 0.2);">
                                            <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-gold); font-weight: 600;">⏰ Set Follow-Up:</span>
                                            <input type="date" id="followup-date-<%= lead.id %>" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; background: #090907; border: 1px solid var(--color-border); border-radius: 6px; color: #fff;">
                                            <input type="time" id="followup-time-<%= lead.id %>" value="14:00" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; background: #090907; border: 1px solid var(--color-border); border-radius: 6px; color: #fff;">
                                            <span style="font-size: 0.7rem; color: var(--color-text-dim);">(Optional · auto-alerts Tiffany 60m prior)</span>
                                        </div>
                                    </div>
                                    <!-- Notes Stream Container -->
                                    <div id="notes-list-<%= lead.id %>" style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 220px; overflow-y: auto;">
                                        <div style="font-size: 0.78rem; color: var(--color-text-dim); font-style: italic;">Loading previous notes...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Client Filter No Matches State -->
            <div id="noFilterMatches" style="display: none; padding: 4rem 2rem; text-align: center; color: var(--color-text-muted);">
                <p style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--color-ivory); margin-bottom: 0.5rem;">No Matching Deals</p>
                <p style="font-size: 0.9rem;">No leads match the current stage tab or search query.</p>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="crmToast" class="crm-toast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D9A23A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span id="crmToastMessage">Status updated successfully</span>
    </div>

    <!-- SAFE CHART DATA SCRIPT TAG -->
    <script id="crm-chart-payload" type="application/json">
        <%- (function() {
            if (!chartData) return '{}';
            if (typeof chartData === 'object') return JSON.stringify(chartData).replace(/</g, '\\u003c');
            if (typeof chartData === 'string') return chartData.replace(/</g, '\\u003c');
            return '{}';
        })() %>
    </script>

    <!-- SCRIPT & CHARTS & CLIENT ENGINE -->
    <script>
        // 1. Chart Initialization
        let chartDataPayload = { sourceData: {}, funnelData: { new: 0, qualified: 0, proposal_sent: 0, booked: 0, completed: 0 } };
        try {
            const rawPayload = document.getElementById('crm-chart-payload').textContent;
            if (rawPayload && rawPayload.trim()) {
                const parsed = JSON.parse(rawPayload);
                if (parsed && typeof parsed === 'object') {
                    chartDataPayload = parsed;
                }
            }
        } catch (e) {
            console.error('Error parsing chart data payload:', e);
        }

        const sourceCtx = document.getElementById('sourceChart');
        if (sourceCtx) {
            const sourceLabels = Object.keys(chartDataPayload.sourceData || {}).map(s => s.replace('_', ' '));
            const sourceValues = Object.values(chartDataPayload.sourceData || {});
            
            new Chart(sourceCtx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: sourceLabels.length > 0 ? sourceLabels : ['Direct Inbound'],
                    datasets: [{
                        data: sourceValues.length > 0 ? sourceValues : [1],
                        backgroundColor: ['#D9A23A', '#E17356', '#6C2D5A', '#10B981', '#38BDF8'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#FBF6EA',
                                font: { family: 'Plus Jakarta Sans', size: 12 },
                                padding: 15
                            }
                        }
                    },
                    cutout: '68%'
                }
            });
        }

        const funnelCtx = document.getElementById('funnelChart');
        let funnelChartInstance = null;
        if (funnelCtx) {
            const ctx2d = funnelCtx.getContext('2d');
            const barGradient = ctx2d.createLinearGradient(0, 0, 0, 240);
            barGradient.addColorStop(0, '#D9A23A');
            barGradient.addColorStop(1, '#6C2D5A');

            const fData = chartDataPayload.funnelData || {};
            funnelChartInstance = new Chart(ctx2d, {
                type: 'bar',
                data: {
                    labels: ['New', 'Qualified', 'Proposal Sent', 'Booked', 'Completed'],
                    datasets: [{
                        label: 'Leads',
                        data: [
                            fData.new || 0, 
                            fData.qualified || 0, 
                            fData.proposal_sent || 0, 
                            fData.booked || 0,
                            fData.completed || 0
                        ],
                        backgroundColor: barGradient,
                        borderRadius: 8,
                        maxBarThickness: 45
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { color: 'rgba(251, 246, 234, 0.6)', stepSize: 1, font: { family: 'JetBrains Mono' } },
                            grid: { color: 'rgba(251, 246, 234, 0.05)' }
                        },
                        x: {
                            ticks: { color: '#FBF6EA', font: { family: 'Plus Jakarta Sans', weight: '600' } },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // 2. Active Filtering State
        let currentFilterStage = 'all';
        let currentSearchQuery = '';

        function filterLedger(stage) {
            currentFilterStage = stage;
            
            // Update Tab UI
            document.querySelectorAll('.status-tab-btn').forEach(btn => {
                if (btn.getAttribute('data-tab-stage') === stage) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            applyLedgerFilters();
        }

        function handleLedgerSearch() {
            const searchInput = document.getElementById('ledgerSearchInput');
            currentSearchQuery = (searchInput ? searchInput.value : '').toLowerCase().trim();
            applyLedgerFilters();
        }

        function applyLedgerFilters() {
            const items = document.querySelectorAll('.ledger-item');
            const noFilterMatches = document.getElementById('noFilterMatches');
            const searchTokens = currentSearchQuery.split(/\s+/).filter(Boolean);
            let visibleCount = 0;

            items.forEach(item => {
                const itemStage = item.getAttribute('data-stage') || '';
                const itemSearch = item.getAttribute('data-search') || '';

                // Stage check
                const stageMatches = (currentFilterStage === 'all') || (itemStage === currentFilterStage);

                // Search tokens check (AND logic)
                const searchMatches = searchTokens.length === 0 || searchTokens.every(token => itemSearch.includes(token));

                if (stageMatches && searchMatches) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (noFilterMatches) {
                noFilterMatches.style.display = (visibleCount === 0) ? 'block' : 'none';
            }
        }

        // 3. Accordion Toggle & Notes Stream
        function toggleDossier(id, event) {
            if (event) event.stopPropagation();
            const item = document.getElementById('lead-item-' + id);
            if (item) {
                const isExpanding = !item.classList.contains('expanded');
                item.classList.toggle('expanded');
                if (isExpanding) {
                    loadLeadNotes(id);
                }
            }
        }

        // Fetch and post notes & follow-ups
        async function loadLeadNotes(leadId) {
            const list = document.getElementById(`notes-list-${leadId}`);
            if (!list) return;
            try {
                const res = await fetch(`/api/leads/${leadId}/notes`);
                if (res.status === 401 || res.redirected) {
                    list.innerHTML = '<div style="font-size: 0.78rem; color: var(--color-gold); font-style: italic;">Session expired. <a href="/login?error=Session+expired" style="color: var(--color-gold); text-decoration: underline;">Log in</a> to view notes.</div>';
                    return;
                }
                const data = await res.json();
                if (data.notes && data.notes.length > 0) {
                    list.innerHTML = data.notes.map(n => {
                        const authorName = n.author_name || 'Staff Member';
                        const initialChar = (authorName.trim().charAt(0) || 'U').toUpperCase();
                        const role = (n.author_role || 'staff').toUpperCase();
                        const timeStr = new Date(n.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                        let followupPill = '';
                        if (n.followup_at) {
                            const fDateStr = new Date(n.followup_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                            const completedClass = n.is_completed ? 'style="opacity: 0.6; text-decoration: line-through;"' : '';
                            followupPill = `
                                <div ${completedClass} style="margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: rgba(217,162,58,0.15); border: 1px solid rgba(217,162,58,0.35); border-radius: 99px; font-size: 0.7rem; color: #D9A23A; font-family: var(--font-mono);">
                                    <span>⏰ Follow-up:</span> <strong>${escapeHtml(fDateStr)}</strong>
                                    ${n.is_completed ? '<span style="color:#10b981; margin-left: 4px;">✓ Completed</span>' : ''}
                                </div>
                            `;
                        }
                        return `
                            <div class="note-card" style="padding: 0.65rem 0.85rem; background: rgba(251, 246, 234, 0.03); border: 1px solid rgba(217, 162, 58, 0.15); border-radius: 8px; font-size: 0.82rem; display: flex; gap: 0.75rem; align-items: flex-start;">
                                <div class="note-avatar" style="width: 28px; height: 28px; min-width: 28px; border-radius: 50%; background: linear-gradient(135deg, #1C1A14 0%, #29241B 100%); border: 1px solid var(--color-gold); color: var(--color-ivory); font-family: var(--font-serif); font-size: 0.85rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.4);">
                                    ${escapeHtml(initialChar)}
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; flex-wrap: wrap; gap: 0.4rem;">
                                        <div style="display: flex; align-items: center; gap: 0.45rem;">
                                            <span style="font-weight: 700; color: var(--color-ivory); font-size: 0.82rem;">${escapeHtml(authorName)}</span>
                                            <span style="display: inline-block; padding: 0.12rem 0.45rem; background: rgba(217, 162, 58, 0.12); border: 1px solid rgba(217, 162, 58, 0.35); border-radius: 100px; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-gold); letter-spacing: 0.05em; text-transform: uppercase;">${escapeHtml(role)}</span>
                                        </div>
                                        <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-dim);">${escapeHtml(timeStr)}</span>
                                    </div>
                                    <div style="color: rgba(251, 246, 234, 0.9); font-size: 0.84rem; line-height: 1.45; white-space: pre-wrap; word-break: break-word;">${escapeHtml(n.note)}</div>
                                    ${followupPill}
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    list.innerHTML = '<div style="font-size: 0.78rem; color: var(--color-text-dim); font-style: italic;">No internal notes recorded yet.</div>';
                }
            } catch (e) {
                list.innerHTML = '<div style="font-size: 0.78rem; color: #ef4444;">Failed to load notes.</div>';
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        async function postLeadNote(leadId) {
            const input = document.getElementById(`note-input-${leadId}`);
            const dateInput = document.getElementById(`followup-date-${leadId}`);
            const timeInput = document.getElementById(`followup-time-${leadId}`);
            if (!input) return;
            const note = input.value.trim();
            if (!note) return;

            const followup_date = (dateInput && dateInput.value) ? dateInput.value : null;
            const followup_time = (timeInput && timeInput.value) ? timeInput.value : null;

            try {
                const res = await fetch(`/api/leads/${leadId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ note, followup_date, followup_time })
                });
                if (res.status === 401 || res.redirected) {
                    showToast('Session expired. Redirecting to login...');
                    setTimeout(() => {
                        window.location.href = '/login?error=Session+expired';
                    }, 800);
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    input.value = '';
                    if (dateInput) dateInput.value = '';
                    loadLeadNotes(leadId); // Refresh notes stream
                    showToast('Note & follow-up saved successfully');
                } else {
                    alert(data.error || 'Failed to post note');
                }
            } catch (e) {
                alert('Server error saving note');
            }
        }

        // 4. AJAX Stage Update
        async function updateLeadStage(id, newStage, event) {
            if (event) event.stopPropagation();
            const selectEl = document.getElementById('stage-select-' + id);
            const rowItem = document.getElementById('lead-item-' + id);
            const previousStage = rowItem ? rowItem.getAttribute('data-stage') : null;

            try {
                const response = await fetch('/lead/' + id + '/status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ status: newStage })
                });

                if (response.ok) {
                    // Update data-stage attribute on row
                    if (rowItem) {
                        rowItem.setAttribute('data-stage', newStage);
                    }

                    // Recalculate Tab and KPI Counts
                    recalculateCounts();

                    // Re-apply filter if not on 'all'
                    applyLedgerFilters();

                    showToast(`Lead #${id} moved to "${getStageLabel(newStage)}"`);
                } else {
                    if (selectEl && previousStage) selectEl.value = previousStage;
                    showToast('Failed to update status on server');
                }
            } catch (err) {
                console.error('AJAX error updating stage:', err);
                if (selectEl && previousStage) selectEl.value = previousStage;
                showToast('Error communicating with server');
            }
        }

        function getStageLabel(stage) {
            const map = {
                'new': 'New Inquiries',
                'contacted': 'Discovery Call',
                'qualified': 'Qualified ($5k+)',
                'proposal_sent': 'Proposal Sent',
                'booked': 'Confirmed Booked',
                'completed': 'Completed',
                'declined': 'Declined',
                'lost': 'Lost'
            };
            return map[stage] || stage;
        }

        function recalculateCounts() {
            const items = Array.from(document.querySelectorAll('.ledger-item'));
            const total = items.length;
            const counts = {
                all: total,
                new: 0,
                contacted: 0,
                qualified: 0,
                proposal_sent: 0,
                booked: 0,
                completed: 0,
                declined: 0,
                lost: 0
            };

            let confirmedRev = 0;

            items.forEach(item => {
                const stage = item.getAttribute('data-stage');
                if (counts[stage] !== undefined) {
                    counts[stage]++;
                }
                const fee = Number(item.getAttribute('data-fee') || 0);
                if ((stage === 'booked' || stage === 'completed') && fee > 0) {
                    confirmedRev += fee;
                }
            });

            // Update Tab Count Badges
            Object.keys(counts).forEach(key => {
                const tabCountEl = document.getElementById('count-tab-' + key);
                if (tabCountEl) {
                    tabCountEl.textContent = counts[key];
                }
            });

            // Update KPI strip
            const kpiRevenue = document.getElementById('kpi-revenue');
            const kpiTotal = document.getElementById('kpi-total-leads');
            const kpiNew = document.getElementById('kpi-new-leads');
            const kpiProposal = document.getElementById('kpi-proposal-leads');
            const kpiBooked = document.getElementById('kpi-booked-leads');
            const kpiCompleted = document.getElementById('kpi-completed-leads');
            const kpiDeclined = document.getElementById('kpi-declined-leads');
            const kpiLost = document.getElementById('kpi-lost-leads');

            if (kpiRevenue) kpiRevenue.textContent = '$' + confirmedRev.toLocaleString('en-US');
            if (kpiTotal) kpiTotal.textContent = total;
            if (kpiNew) kpiNew.textContent = counts['new'];
            if (kpiProposal) kpiProposal.textContent = counts['proposal_sent'];
            if (kpiBooked) kpiBooked.textContent = counts['booked'];
            if (kpiCompleted) kpiCompleted.textContent = counts['completed'];
            if (kpiDeclined) kpiDeclined.textContent = counts['declined'];
            if (kpiLost) kpiLost.textContent = counts['lost'];

            // Update Funnel Chart if initialized
            if (funnelChartInstance && funnelChartInstance.data && funnelChartInstance.data.datasets && funnelChartInstance.data.datasets[0]) {
                funnelChartInstance.data.datasets[0].data = [
                    counts['new'],
                    counts['qualified'],
                    counts['proposal_sent'],
                    counts['booked'],
                    counts['completed']
                ];
                funnelChartInstance.update();
            }
        }

        // 5. Toast Feedback Helper
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('crmToast');
            const toastMsg = document.getElementById('crmToastMessage');
            if (toast && toastMsg) {
                toastMsg.textContent = message;
                toast.classList.add('show');
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => {
                    toast.classList.remove('show');
                }, 3200);
            }
        }

        // 6. Delete Handlers
        async function deleteSingleLead(id, event) {
            if (event) event.stopPropagation();
            if (!confirm(`Are you sure you want to delete Lead #${id}? This action cannot be reversed.`)) {
                return;
            }

            try {
                const response = await fetch('/lead/' + id + '/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok || response.redirected) {
                    const rowItem = document.getElementById('lead-item-' + id);
                    if (rowItem) {
                        rowItem.remove();
                    }
                    recalculateCounts();
                    applyLedgerFilters();
                    showToast(`Lead #${id} deleted successfully`);
                } else {
                    showToast('Failed to delete lead');
                }
            } catch (err) {
                console.error(err);
                showToast('Error communicating with server');
            }
        }

        async function bulkDeletePrompt() {
            const msg = currentFilterStage === 'all'
                ? "Are you absolutely certain you want to purge ALL leads from the system?"
                : `Are you sure you want to purge all leads in the '${getStageLabel(currentFilterStage)}' stage?`;

            if (confirm(msg)) {
                try {
                    const response = await fetch('/api/leads/bulk-delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: currentFilterStage })
                    });
                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                    } else {
                        showToast(result.error || 'Failed to purge leads');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Error communicating with server');
                }
            }
        }

        // 6.5. Role-Based Guide Me Modal Logic
        function openGuideModal() {
            const modal = document.getElementById('guideModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeGuideModal() {
            const modal = document.getElementById('guideModal');
            if (modal) modal.style.display = 'none';
        }

        function switchGuideTab(role) {
            const tabs = ['staff', 'assistant', 'admin'];
            tabs.forEach(r => {
                const btn = document.getElementById('guide-tab-' + r);
                const content = document.getElementById('guide-content-' + r);
                if (btn && content) {
                    if (r === role) {
                        btn.style.background = 'rgba(217,162,58,0.15)';
                        btn.style.color = '#D9A23A';
                        btn.style.borderColor = 'rgba(217,162,58,0.3)';
                        content.style.display = 'block';
                    } else {
                        btn.style.background = 'transparent';
                        btn.style.color = 'rgba(251,246,234,0.6)';
                        btn.style.borderColor = 'rgba(255,255,255,0.1)';
                        content.style.display = 'none';
                    }
                }
            });
        }
    </script>
    <script src="/js/impact-os-cursor.js"></script>
</body>
</html>
