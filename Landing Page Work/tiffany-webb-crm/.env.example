# ==============================================================================
# Tiffany Webb Impact OS™ — Environment Example
# ==============================================================================

PORT=3000
NODE_ENV=production

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tiffany_crm
DB_SSL=false

# Security & Session Authentication
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_64_characters

# Nodemailer / Mailer Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_HOST_USER=booking@tiffanywebbimpact.com
EMAIL_HOST_PASSWORD=your_email_app_password
BRIEFING_EMAIL=booking@tiffanywebbimpact.com

# Canonical URL & Domain Whitelist
FRONTEND_URL=https://tiffanywebbimpact.com
CRM_URL=https://crm.tiffanywebbimpact.com
